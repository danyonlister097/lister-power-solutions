            </div>
            <% } %>
          </div>
        <% } %>
      </li>
    <% }) %>
  </ul>
<% } %>

<!-- Renewal Detail Modal (read-only quick view - click a status chip to open) -->
<div id="renewal-detail-modal" class="modal-backdrop" hidden>
  <div class="modal" role="dialog" aria-modal="true" aria-labelledby="renewal-detail-title">
    <button type="button" class="modal-close" id="renewal-detail-close" aria-label="Close">&times;</button>
    <span class="badge" id="renewal-detail-status"></span>
    <h2 id="renewal-detail-title" style="margin-top:0.5rem;"></h2>
    <dl class="detail-grid">
      <dt>Category</dt><dd id="renewal-detail-category"></dd>
      <dt class="renewal-detail-optional" id="renewal-detail-assignee-label">Assigned to</dt><dd class="renewal-detail-optional" id="renewal-detail-assignee"></dd>
      <dt>Expiry date</dt><dd id="renewal-detail-expiry"></dd>
      <dt class="renewal-detail-optional" id="renewal-detail-notes-label">Notes</dt><dd class="renewal-detail-optional" id="renewal-detail-notes"></dd>
      <dt class="renewal-detail-optional" id="renewal-detail-source-label">Source</dt><dd class="renewal-detail-optional" id="renewal-detail-source"></dd>
    </dl>
    <div class="actions">
      <button type="button" class="btn btn-primary btn-sm" id="renewal-detail-edit" hidden>Edit</button>
      <button type="button" class="btn btn-secondary btn-sm" id="renewal-detail-close-btn">Close</button>
    </div>
  </div>
</div>

<script>
(function () {
  var modal = document.getElementById('renewal-detail-modal');
  var editBtn = document.getElementById('renewal-detail-edit');
  var activeRowEditBtn = null;

  function setOptionalField(labelId, valueId, value) {
    var label = document.getElementById(labelId);
    var el = document.getElementById(valueId);
    if (value) {
      label.style.display = '';
      el.style.display = '';
      el.textContent = value;
    } else {
      label.style.display = 'none';
      el.style.display = 'none';
    }
  }

  function openDetail(btn) {
    document.getElementById('renewal-detail-title').textContent = btn.getAttribute('data-title') || '';
    var statusEl = document.getElementById('renewal-detail-status');
    statusEl.className = 'badge ' + (btn.className.match(/badge-\S+/) || [''])[0];
    statusEl.textContent = btn.textContent;
    document.getElementById('renewal-detail-category').textContent = btn.getAttribute('data-category-label') || '';
    setOptionalField('renewal-detail-assignee-label', 'renewal-detail-assignee', btn.getAttribute('data-assignee'));
    document.getElementById('renewal-detail-expiry').textContent = btn.getAttribute('data-expiry') || 'No date set';
    setOptionalField('renewal-detail-notes-label', 'renewal-detail-notes', btn.getAttribute('data-notes'));
    setOptionalField('renewal-detail-source-label', 'renewal-detail-source', btn.getAttribute('data-source-label'));

    // Only real renewal rows (not the live-joined asset/document ones) carry
    // a .renewal-edit-btn - reusing it (rather than duplicating its data
    // attributes here) means this modal works the same for non-admins
    // (where that button, and its edit form, simply don't exist).
    activeRowEditBtn = btn.closest('li').querySelector('.renewal-edit-btn');
    editBtn.hidden = !activeRowEditBtn;

    modal.hidden = false;
  }

  function closeModal() { modal.hidden = true; }

  document.getElementById('renewal-detail-close').addEventListener('click', closeModal);
  document.getElementById('renewal-detail-close-btn').addEventListener('click', closeModal);
  modal.addEventListener('click', function (e) { if (e.target === modal) closeModal(); });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !modal.hidden) closeModal(); });

  editBtn.addEventListener('click', function () {
    closeModal();
    if (activeRowEditBtn) activeRowEditBtn.click();
  });

  document.addEventListener('click', function (e) {
    var detailBtn = e.target.closest('.renewal-detail-btn');
    if (detailBtn) {
      e.preventDefault();
      openDetail(detailBtn);
      return;
    }
    var rowLink = e.target.closest('.renewal-row-link');
    if (rowLink && rowLink.getAttribute('data-href')) {
      window.location.href = rowLink.getAttribute('data-href');
    }
  });

  document.addEventListener('keydown', function (e) {
    if (e.key !== 'Enter' && e.key !== ' ') return;
    var rowLink = e.target.closest('.renewal-row-link');
    if (!rowLink) return;
    e.preventDefault();
    window.location.href = rowLink.getAttribute('data-href');
  });
})();
</script>

<% if (isAdmin) { %>
<!-- Add / Edit Renewal Modal -->
<div id="renewal-add-modal" class="modal-backdrop" hidden>
  <div class="modal" role="dialog" aria-modal="true" aria-labelledby="renewal-modal-title">
    <button type="button" class="modal-close" id="renewal-modal-close" aria-label="Close">&times;</button>
    <h2 id="renewal-modal-title">Add Renewal</h2>
    <form method="post" id="renewal-form" action="/renewals">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="_id" value="">
      <label>
        Title *
        <input type="text" name="title" required>
      </label>
      <div class="form-row form-row-2">
        <label>
          Category
          <select name="category" id="renewal-cat-select">
            <% CATEGORIES.forEach(c => { %>
              <option value="<%= c.key %>"><%= c.label %></option>
            <% }) %>
            <option value="__manage__" style="color:var(--color-primary);">+ Add category…</option>
          </select>
        </label>
        <label>
          Expiry Date *
          <input type="date" name="expiry_date" required>
        </label>
      </div>
      <div class="form-row form-row-2">
        <label>
          Linked Staff Member <span style="font-weight:400;">(optional)</span>
          <select name="user_id">
            <option value="">None</option>
            <% users.forEach(u => { %>
              <option value="<%= u.id %>"><%= u.name %></option>
            <% }) %>
          </select>
        </label>
        <label>
          Linked Asset <span style="font-weight:400;">(optional)</span>
          <select name="asset_id">
            <option value="">None</option>
            <% assets.forEach(a => { %>
              <option value="<%= a.id %>"><%= a.name %></option>
            <% }) %>
          </select>
        </label>
      </div>
      <label>
        Notes <span style="font-weight:400;">(optional)</span>
        <textarea name="notes" rows="2"></textarea>
      </label>
      <div class="actions">
        <button type="submit" class="btn btn-primary" id="renewal-submit-btn">Add Renewal</button>
        <button type="button" class="btn btn-secondary" id="renewal-modal-cancel">Cancel</button>
      </div>
    </form>
  </div>
</div>

<script>
(function () {
  // ── Add / Edit Renewal modal ──
  var modal = document.getElementById('renewal-add-modal');
  var form = document.getElementById('renewal-form');
  var titleEl = document.getElementById('renewal-modal-title');
  var submitBtn = document.getElementById('renewal-submit-btn');
  var openBtn = document.getElementById('renewal-add-open');
  var closeBtn = document.getElementById('renewal-modal-close');
  var cancelBtn = document.getElementById('renewal-modal-cancel');
  var idInput = form.querySelector('input[name="_id"]');
  var catSelect = document.getElementById('renewal-cat-select');

  // "+ Add category…" opens the shared Manage Categories modal (see top of
  // page) instead of actually selecting it.
  window.wireManageCategoryOption(catSelect);

  function openAdd() {
    titleEl.textContent = 'Add Renewal';
    submitBtn.textContent = 'Add Renewal';
    form.action = '/renewals';
    form.reset();
    idInput.value = '';
    modal.hidden = false;
  }

  function openEdit(btn) {
    titleEl.textContent = 'Edit Renewal';
    submitBtn.textContent = 'Save Changes';
    var id = btn.getAttribute('data-id');
    form.action = '/renewals/' + id;
    idInput.value = id;
    form.querySelector('[name="title"]').value = btn.getAttribute('data-title') || '';
    catSelect.value = btn.getAttribute('data-category') || '';
    catSelect.dataset.prev = catSelect.value;
    form.querySelector('[name="user_id"]').value = btn.getAttribute('data-user_id') || '';
    form.querySelector('[name="asset_id"]').value = btn.getAttribute('data-asset_id') || '';
    form.querySelector('[name="expiry_date"]').value = btn.getAttribute('data-expiry_date') || '';
    form.querySelector('[name="notes"]').value = btn.getAttribute('data-notes') || '';
    modal.hidden = false;
  }

  function closeModal() { modal.hidden = true; }

  if (openBtn) openBtn.addEventListener('click', openAdd);
  closeBtn.addEventListener('click', closeModal);
  cancelBtn.addEventListener('click', closeModal);
  modal.addEventListener('click', function (e) { if (e.target === modal) closeModal(); });
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && !modal.hidden) closeModal();
  });

  document.addEventListener('click', function (e) {
    var btn = e.target.closest('.renewal-edit-btn');
    if (!btn) return;
    openEdit(btn);
  });
})();
</script>
<% } %>
<% } %>

<% if (tab === 'documents') { %>
  <%
    function docExpiryClass(dateStr, today) {
      if (!dateStr) return 'badge-pending';
      return expiryClass(dateStr, today);
    }
    function docExpiryLabel(dateStr, today) {
      if (!dateStr) return 'No expiry';
      return expiryLabel(dateStr, today);
    }
  %>
  <div class="filters">
    <a class="<%= category === '' ? 'active' : '' %>" href="<%= renewalsUrl({ category: '', tab: 'documents' }) %>">All</a>
    <% CATEGORIES.forEach(c => { %>
      <a class="<%= category === c.key ? 'active' : '' %>" href="<%= renewalsUrl({ category: c.key, tab: 'documents' }) %>"><%= c.label %></a>
    <% }) %>
  </div>

  <form method="get" class="card" style="display:flex;gap:1rem;flex-wrap:wrap;align-items:flex-end;">
    <input type="hidden" name="tab" value="documents">
    <input type="hidden" name="category" value="<%= category %>">
    <label style="flex:1;min-width:200px;">
      Staff member
      <select name="employee" onchange="this.form.requestSubmit()">
        <option value="">Anyone</option>
        <% users.forEach(u => { %>
          <option value="<%= u.id %>" <%= String(employee) === String(u.id) ? 'selected' : '' %>><%= u.name %></option>
        <% }) %>
      </select>
    </label>
    <% if (employee) { %><a href="<%= renewalsUrl({ employee: '', tab: 'documents' }) %>" class="btn btn-secondary btn-sm">Clear</a><% } %>
  </form>

  <% if (!documents.length) { %>
    <div class="empty-state">
      <%= (category || employee) ? 'No documents match this filter.' : 'No documents or licenses on file yet.' %>
    </div>
  <% } else { %>
    <ul class="list">
      <% documents.forEach(doc => { %>
        <li>
          <div class="list-item row-menu-hover-target" style="padding:0;gap:0;">
            <span style="flex:1;display:flex;align-items:center;justify-content:space-between;padding:0.9rem 1rem;gap:0.5rem;min-width:0;">
              <span style="min-width:0;">
                <span class="list-item-title"><%= doc.title %></span><br>
                <span class="list-item-meta">
                  <%= catLabel(doc.category) %>
                  <% if (doc.license_number) { %> &middot; <%= doc.license_number %><% } %>
                  <% if (doc.user_name) { %> &middot; <%= doc.user_name %><% } %>
                  <% if (doc.expiry_date) { %> &middot; Expires <%= formatAuDate(doc.expiry_date) %><% } %>
                  <% if (doc.notes) { %> &middot; <em><%= doc.notes %></em><% } %>
                  <% if (doc.create_renewal) { %> &middot; <em>📅 Also on Renewals</em><% } %>
                  <% if (doc.file_url) { %> &middot; <a href="/renewals/documents/<%= doc.id %>/file" target="_blank" rel="noopener">📎 View file</a><% } %>
                </span>
              </span>
              <span class="badge <%= docExpiryClass(doc.expiry_date, todayIso) %>"><%= docExpiryLabel(doc.expiry_date, todayIso) %></span>
            </span>
            <% if (isAdmin) { %>
            <div class="row-menu-cell" style="padding-right:0.5rem;position:relative;">
              <button class="row-menu-btn" aria-label="More actions" aria-expanded="false">⋮</button>
              <div class="context-menu" hidden>
                <button type="button" class="context-menu-item document-edit-btn"
                  data-id="<%= doc.id %>"
                  data-title="<%= doc.title %>"
                  data-license_number="<%= doc.license_number || '' %>"
                  data-category="<%= doc.category || '' %>"
                  data-user_id="<%= doc.user_id || '' %>"
                  data-expiry_date="<%= doc.expiry_date || '' %>"
                  data-notes="<%= doc.notes || '' %>"
                  data-create_renewal="<%= doc.create_renewal ? '1' : '' %>">Edit</button>
                <form method="post" action="/renewals/documents/<%= doc.id %>/delete"
                      data-confirm="Delete this document? This cannot be undone." style="margin:0;">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="context-menu-item context-menu-danger">Delete</button>
                </form>
              </div>
            </div>
            <% } %>
          </div>
        </li>
      <% }) %>
    </ul>
  <% } %>

  <% if (isAdmin) { %>
  <!-- Add / Edit Document Modal -->
  <div id="document-add-modal" class="modal-backdrop" hidden>
    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="document-modal-title">
      <button type="button" class="modal-close" id="document-modal-close" aria-label="Close">&times;</button>
      <h2 id="document-modal-title">Add Document</h2>
      <form method="post" id="document-form" action="/renewals/documents" enctype="multipart/form-data">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label>
          Title *
          <input type="text" name="title" required placeholder="e.g. Electrical Contractor Licence">
        </label>
        <div class="form-row form-row-2">
          <label>
            Licence / Reference number <span style="font-weight:400;">(optional)</span>
            <input type="text" name="license_number">
          </label>
          <label>
            Expiry Date <span style="font-weight:400;">(optional)</span>
            <input type="date" name="expiry_date">
          </label>
        </div>
        <label>
          Category
          <select name="category" id="document-cat-select">
            <% CATEGORIES.forEach(c => { %>
              <option value="<%= c.key %>"><%= c.label %></option>
            <% }) %>
            <option value="__manage__" style="color:var(--color-primary);">+ Add category…</option>
          </select>
        </label>
        <label class="toggle-label">
          <span>Also create a renewal reminder <span style="font-weight:400;">(shows this on the Renewals tab too, using the same expiry date, instead of entering it twice)</span></span>
          <span class="toggle-switch">
            <input type="checkbox" name="create_renewal" value="1" id="document-create-renewal">
            <span class="toggle-slider"></span>
          </span>
        </label>
        <label>
          Linked Staff Member <span style="font-weight:400;">(optional)</span>
          <select name="user_id">
            <option value="">None</option>
            <% users.forEach(u => { %>
              <option value="<%= u.id %>"><%= u.name %></option>
            <% }) %>
          </select>
        </label>
        <label>
          Notes <span style="font-weight:400;">(optional)</span>
          <textarea name="notes" rows="2"></textarea>
        </label>
        <label>
          Photo / file <span style="font-weight:400;">(image or PDF, max 20 MB)</span>
          <input type="file" name="attachment" accept="image/*,.pdf">
          <span id="document-current-file" class="text-muted" style="font-size:0.8rem;display:none;"></span>
        </label>
        <div class="actions">
          <button type="submit" class="btn btn-primary" id="document-submit-btn">Add Document</button>
          <button type="button" class="btn btn-secondary" id="document-modal-cancel">Cancel</button>
        </div>
      </form>
    </div>
  </div>

  <script>
  (function () {
    var modal = document.getElementById('document-add-modal');
    var form = document.getElementById('document-form');
    var titleEl = document.getElementById('document-modal-title');
    var submitBtn = document.getElementById('document-submit-btn');
    var openBtn = document.getElementById('document-add-open');
    var closeBtn = document.getElementById('document-modal-close');
    var cancelBtn = document.getElementById('document-modal-cancel');
    var currentFileEl = document.getElementById('document-current-file');
    var catSelect = document.getElementById('document-cat-select');

    // "+ Add category…" opens the shared Manage Categories modal (see top of
    // page) instead of actually selecting it.
    window.wireManageCategoryOption(catSelect);

    function openAdd() {
      titleEl.textContent = 'Add Document';
      submitBtn.textContent = 'Add Document';
      form.action = '/renewals/documents';
      form.reset();
      catSelect.dataset.prev = catSelect.value;
      currentFileEl.style.display = 'none';
      modal.hidden = false;
    }

    function openEdit(btn) {
      titleEl.textContent = 'Edit Document';
      submitBtn.textContent = 'Save Changes';
      var id = btn.getAttribute('data-id');
      form.action = '/renewals/documents/' + id;
      form.querySelector('[name="title"]').value = btn.getAttribute('data-title') || '';
      form.querySelector('[name="license_number"]').value = btn.getAttribute('data-license_number') || '';
      if (btn.getAttribute('data-category')) catSelect.value = btn.getAttribute('data-category');
      catSelect.dataset.prev = catSelect.value;
      form.querySelector('[name="user_id"]').value = btn.getAttribute('data-user_id') || '';
      form.querySelector('[name="expiry_date"]').value = btn.getAttribute('data-expiry_date') || '';
      form.querySelector('[name="notes"]').value = btn.getAttribute('data-notes') || '';
      form.querySelector('[name="create_renewal"]').checked = btn.getAttribute('data-create_renewal') === '1';
      currentFileEl.style.display = 'none';
      modal.hidden = false;
    }

    function closeModal() { modal.hidden = true; }

    if (openBtn) openBtn.addEventListener('click', openAdd);
    closeBtn.addEventListener('click', closeModal);
    cancelBtn.addEventListener('click', closeModal);
    modal.addEventListener('click', function (e) { if (e.target === modal) closeModal(); });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && !modal.hidden) closeModal();
    });

    document.addEventListener('click', function (e) {
      var btn = e.target.closest('.document-edit-btn');
      if (!btn) return;
      openEdit(btn);
    });
  })();
  </script>
  <% } %>
<% } %>

<%- include('../partials/footer') %>
