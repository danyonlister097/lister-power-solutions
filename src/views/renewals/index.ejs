            <% if (isAdmin) { %><div class="row-menu-cell" style="padding-right:0.5rem;"></div><% } %>
          </div>
        <% } else if (item.source === 'document') { %>
          <div class="list-item row-menu-hover-target renewal-row-link" data-href="/renewals?tab=documents" role="link" tabindex="0" style="padding:0;gap:0;cursor:pointer;">
            <span style="flex:1;display:flex;align-items:center;justify-content:space-between;padding:0.9rem 1rem;gap:0.5rem;min-width:0;">
              <span style="min-width:0;">
                <span class="list-item-title"><%= item.title %></span><br>
                <span class="list-item-meta">
                  <%= catLabel(item.category) %>
                  <% if (item.user_name) { %> &middot; <%= item.user_name %><% } %>
                  <% if (item.expiry_date) { %> &middot; <%= formatAuDate(item.expiry_date) %><% } %>
                  &middot; <em>from Documents/Licensing</em>
                </span>
              </span>
              <button type="button" class="badge renewal-detail-btn <%= expiryClass(item.expiry_date, todayIso) %>"
                data-title="<%= item.title %>"
                data-category-label="<%= catLabel(item.category) %>"
                data-assignee="<%= item.user_name || '' %>"
                data-expiry="<%= item.expiry_date ? formatAuDate(item.expiry_date) : '' %>"
                data-notes="<%= item.notes || '' %>"
                data-source-label="Documents/Licensing"><%= expiryLabel(item.expiry_date, todayIso) %></button>
            </span>
            <% if (isAdmin) { %><div class="row-menu-cell" style="padding-right:0.5rem;"></div><% } %>
          </div>
        <% } else { %>
          <div class="list-item row-menu-hover-target" style="padding:0;gap:0;">
            <span style="flex:1;display:flex;align-items:center;justify-content:space-between;padding:0.9rem 1rem;gap:0.5rem;min-width:0;">
              <span style="min-width:0;">
                <span class="list-item-title"><%= item.title %></span><br>
                <span class="list-item-meta">
                  <%= catLabel(item.category) %>
                  <% if (item.user_name) { %> &middot; <%= item.user_name %><% } %>
                  <% if (item.asset_name) { %> &middot; <%= item.asset_name %><% } %>
                  <% if (item.expiry_date) { %> &middot; <%= formatAuDate(item.expiry_date) %><% } %>
                  <% if (item.notes) { %> &middot; <em><%= item.notes %></em><% } %>
                </span>
              </span>
              <button type="button" class="badge renewal-detail-btn <%= expiryClass(item.expiry_date, todayIso) %>"
                data-title="<%= item.title %>"
                data-category-label="<%= catLabel(item.category) %>"
                data-assignee="<%= item.user_name || item.asset_name || '' %>"
                data-expiry="<%= item.expiry_date ? formatAuDate(item.expiry_date) : '' %>"
                data-notes="<%= item.notes || '' %>"
                data-source-label=""><%= expiryLabel(item.expiry_date, todayIso) %></button>
            </span>
            <% if (isAdmin) { %>
            <div class="row-menu-cell" style="padding-right:0.5rem;position:relative;">
              <button class="row-menu-btn" aria-label="More actions" aria-expanded="false">⋮</button>
              <div class="context-menu" hidden>
                <button type="button" class="context-menu-item renewal-edit-btn"
                  data-id="<%= item.id %>"
                  data-title="<%= item.title %>"
                  data-category="<%= item.category %>"
                  data-user_id="<%= item.user_id || '' %>"
                  data-asset_id="<%= item.asset_id || '' %>"
                  data-expiry_date="<%= item.expiry_date || '' %>"
                  data-notes="<%= item.notes || '' %>">Edit</button>
                <form method="post" action="/renewals/<%= item.id %>/duplicate" style="margin:0;">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="context-menu-item">Duplicate</button>
