<%- include('../partials/header', { title: 'Renewals' }) %>
<%
  function expiryClass(dateStr, today) {
    if (!dateStr) return 'badge-pending';
    if (dateStr < today) return 'badge-cancelled';
    var d30 = new Date(today);
    d30.setDate(d30.getDate() + 30);
    var d60 = new Date(today);
    d60.setDate(d60.getDate() + 60);
    var exp = new Date(dateStr);
    if (exp <= d30) return 'badge-overdue';
    if (exp <= d60) return 'badge-in_progress';
    return 'badge-scheduled';
  }
  function expiryLabel(dateStr, today) {
    if (!dateStr) return 'No date';
    if (dateStr < today) return 'Overdue';
    var d30 = new Date(today);
    d30.setDate(d30.getDate() + 30);
    var d60 = new Date(today);
    d60.setDate(d60.getDate() + 60);
    var exp = new Date(dateStr);
    if (exp <= d30) return 'Due within 30 days';
    if (exp <= d60) return 'Due within 60 days';
    return 'OK';
  }
  function catLabel(key) {
    var c = CATEGORIES.find(function(x) { return x.key === key; });
    return c ? c.label : key;
  }
%>
<div class="page-header">
  <h1>Renewals</h1>
  <% if (isAdmin) { %>
    <button type="button" class="btn btn-primary" id="renewal-add-open">+ Add Renewal</button>
  <% } %>
</div>

<div class="filters">
  <a class="<%= category === '' ? 'active' : '' %>" href="/renewals">All</a>
  <% CATEGORIES.forEach(c => { %>
    <a class="<%= category === c.key ? 'active' : '' %>" href="/renewals?category=<%= c.key %>"><%= c.label %></a>
  <% }) %>
</div>

<% if (!items.length) { %>
  <div class="empty-state">No renewal items match this filter.</div>
<% } else { %>
  <ul class="list">
    <% items.forEach(item => { %>
      <li>
        <% if (item.source === 'asset') { %>
          <a href="/assets/<%= item.asset_register_id %>?returnTo=/renewals" class="list-item row-menu-hover-target" style="text-decoration:none;">
            <span style="min-width:0;flex:1;">
              <span class="list-item-title"><%= item.title %></span><br>
              <span class="list-item-meta">
                Vehicle Rego
                <% if (item.expiry_date) { %> &middot; <%= formatAuDate(item.expiry_date) %><% } %>
                &middot; <em>from Asset Register</em>
              </span>
            </span>
            <span class="badge <%= expiryClass(item.expiry_date, todayIso) %>"><%= expiryLabel(item.expiry_date, todayIso) %></span>
          </a>
        <% } else { %>
          <div class="list-item row-menu-hover-target" style="padding:0;gap:0;">
            <span style="flex:1;display:flex;align-items:center;justify-content:space-between;padding:0.9rem 1rem;gap:0.5rem;min-width:0;">
              <span style="min-width:0;">
                <span class="list-item-title"><%= item.title %></span><br>
                <span class="list-item-meta">
                  <%= catLabel(item.category) %>
                  <% if (item.user_name) { %> &middot; <%= item.user_name %><% } %>
                  <% if (item.asset_name) { %> &middot; <%= item.asset_name %><% } %>
                  <% if (item.expiry_date) { %> &middot; <%= formatAuDate(item.expiry_date) %><% } %>
                  <% if (item.notes) { %> &middot; <em><%= item.notes %></em><% } %>
                </span>
              </span>
              <span class="badge <%= expiryClass(item.expiry_date, todayIso) %>"><%= expiryLabel(item.expiry_date, todayIso) %></span>
            </span>
            <% if (isAdmin) { %>
            <div class="row-menu-cell" style="padding-right:0.5rem;position:relative;">
              <button class="row-menu-btn" aria-label="More actions" aria-expanded="false">⋮</button>
              <div class="context-menu" hidden>
                <button type="button" class="context-menu-item renewal-edit-btn"
                  data-id="<%= item.id %>"
                  data-title="<%= item.title %>"
                  data-category="<%= item.category %>"
                  data-user_id="<%= item.user_id || '' %>"
                  data-asset_id="<%= item.asset_id || '' %>"
                  data-expiry_date="<%= item.expiry_date || '' %>"
                  data-notes="<%= item.notes || '' %>">Edit</button>
                <form method="post" action="/renewals/<%= item.id %>/duplicate" style="margin:0;">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="context-menu-item">Duplicate</button>
                </form>
                <form method="post" action="/renewals/<%= item.id %>/delete"
                      data-confirm="Delete this renewal? This cannot be undone." style="margin:0;">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="context-menu-item context-menu-danger">Delete</button>
                </form>
              </div>
            </div>
            <% } %>
          </div>
        <% } %>
      </li>
    <% }) %>
  </ul>
<% } %>

<% if (isAdmin) { %>
<!-- Manage Categories Modal -->
<div id="manage-cat-modal" class="modal-backdrop" hidden>
  <div class="modal" role="dialog" aria-modal="true" aria-labelledby="manage-cat-title" style="max-width:420px;">
    <button type="button" class="modal-close" id="manage-cat-close" aria-label="Close">&times;</button>
    <h2 id="manage-cat-title">Manage Categories</h2>
    <ul style="list-style:none;padding:0;margin:0 0 1rem;">
      <% CATEGORIES.forEach(c => { %>
        <li style="display:flex;align-items:center;justify-content:space-between;padding:0.4rem 0;border-bottom:1px solid var(--color-border);">
          <span><%= c.label %></span>
          <form method="post" action="/renewals/categories/<%= c.id %>/delete"
                data-confirm="Delete the &quot;<%= c.label %>&quot; category? Renewals already using it will keep the old value." style="margin:0;">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="context-menu-item context-menu-danger" style="padding:0.15rem 0.5rem;font-size:0.8rem;">Delete</button>
          </form>
        </li>
      <% }) %>
    </ul>
    <form method="post" action="/renewals/categories" style="display:flex;gap:0.5rem;">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="text" name="label" required placeholder="New category name" style="flex:1;">
      <button type="submit" class="btn btn-primary" style="white-space:nowrap;">Add</button>
    </form>
  </div>
</div>

<!-- Add / Edit Renewal Modal -->
<div id="renewal-add-modal" class="modal-backdrop" hidden>
  <div class="modal" role="dialog" aria-modal="true" aria-labelledby="renewal-modal-title">
    <button type="button" class="modal-close" id="renewal-modal-close" aria-label="Close">&times;</button>
    <h2 id="renewal-modal-title">Add Renewal</h2>
    <form method="post" id="renewal-form" action="/renewals">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="_id" value="">
      <label>
        Title *
        <input type="text" name="title" required>
      </label>
      <div class="form-row form-row-2">
        <label>
          Category
          <select name="category" id="renewal-cat-select">
            <% CATEGORIES.forEach(c => { %>
              <option value="<%= c.key %>"><%= c.label %></option>
            <% }) %>
            <option value="__manage__" style="color:var(--color-primary);">+ Add category…</option>
          </select>
        </label>
        <label>
          Expiry Date *
          <input type="date" name="expiry_date" required>
        </label>
      </div>
      <div class="form-row form-row-2">
        <label>
          Linked Staff Member <span style="font-weight:400;">(optional)</span>
          <select name="user_id">
            <option value="">None</option>
            <% users.forEach(u => { %>
              <option value="<%= u.id %>"><%= u.name %></option>
            <% }) %>
          </select>
        </label>
        <label>
          Linked Asset <span style="font-weight:400;">(optional)</span>
          <select name="asset_id">
            <option value="">None</option>
            <% assets.forEach(a => { %>
              <option value="<%= a.id %>"><%= a.name %></option>
            <% }) %>
          </select>
        </label>
      </div>
      <label>
        Notes <span style="font-weight:400;">(optional)</span>
        <textarea name="notes" rows="2"></textarea>
      </label>
      <div class="actions">
        <button type="submit" class="btn btn-primary" id="renewal-submit-btn">Add Renewal</button>
        <button type="button" class="btn btn-secondary" id="renewal-modal-cancel">Cancel</button>
      </div>
    </form>
  </div>
</div>

<script>
(function () {
  // ── Manage Categories modal ──
  var manageCatModal = document.getElementById('manage-cat-modal');
  document.getElementById('manage-cat-close').addEventListener('click', function () { manageCatModal.hidden = true; });
  manageCatModal.addEventListener('click', function (e) { if (e.target === manageCatModal) manageCatModal.hidden = true; });

  // ── Add / Edit Renewal modal ──
  var modal = document.getElementById('renewal-add-modal');
  var form = document.getElementById('renewal-form');
  var titleEl = document.getElementById('renewal-modal-title');
  var submitBtn = document.getElementById('renewal-submit-btn');
  var openBtn = document.getElementById('renewal-add-open');
  var closeBtn = document.getElementById('renewal-modal-close');
  var cancelBtn = document.getElementById('renewal-modal-cancel');
  var idInput = form.querySelector('input[name="_id"]');
  var catSelect = document.getElementById('renewal-cat-select');

  // Intercept "+ Add category…" option
  catSelect.addEventListener('change', function () {
    if (catSelect.value === '__manage__') {
      catSelect.value = catSelect.dataset.prev || catSelect.options[0].value;
      modal.hidden = true;
      manageCatModal.hidden = false;
    } else {
      catSelect.dataset.prev = catSelect.value;
    }
  });

  function openAdd() {
    titleEl.textContent = 'Add Renewal';
    submitBtn.textContent = 'Add Renewal';
    form.action = '/renewals';
    form.reset();
    idInput.value = '';
    modal.hidden = false;
  }

  function openEdit(btn) {
    titleEl.textContent = 'Edit Renewal';
    submitBtn.textContent = 'Save Changes';
    var id = btn.getAttribute('data-id');
    form.action = '/renewals/' + id;
    idInput.value = id;
    form.querySelector('[name="title"]').value = btn.getAttribute('data-title') || '';
    catSelect.value = btn.getAttribute('data-category') || '';
    catSelect.dataset.prev = catSelect.value;
    form.querySelector('[name="user_id"]').value = btn.getAttribute('data-user_id') || '';
    form.querySelector('[name="asset_id"]').value = btn.getAttribute('data-asset_id') || '';
    form.querySelector('[name="expiry_date"]').value = btn.getAttribute('data-expiry_date') || '';
    form.querySelector('[name="notes"]').value = btn.getAttribute('data-notes') || '';
    modal.hidden = false;
  }

  function closeModal() { modal.hidden = true; }

  if (openBtn) openBtn.addEventListener('click', openAdd);
  closeBtn.addEventListener('click', closeModal);
  cancelBtn.addEventListener('click', closeModal);
  modal.addEventListener('click', function (e) { if (e.target === modal) closeModal(); });
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') {
      if (!modal.hidden) closeModal();
      if (!manageCatModal.hidden) manageCatModal.hidden = true;
    }
  });

  document.addEventListener('click', function (e) {
    var btn = e.target.closest('.renewal-edit-btn');
    if (!btn) return;
    openEdit(btn);
  });
})();
</script>
<% } %>
<%- include('../partials/footer') %>
