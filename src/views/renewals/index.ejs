<% } else { %>
  <ul class="list">
    <% items.forEach(item => { %>
      <li>
        <% if (item.source === 'asset') { %>
          <div class="list-item row-menu-hover-target renewal-row-link" data-href="/assets/<%= item.asset_register_id %>?returnTo=/renewals" role="link" tabindex="0" style="padding:0;gap:0;cursor:pointer;">
