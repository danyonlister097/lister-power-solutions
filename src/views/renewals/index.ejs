<%- include('../partials/header', { title: title }) %>
<%
  function expiryClass(dateStr, today) {
    if (!dateStr) return 'badge-pending';
    if (dateStr < today) return 'badge-cancelled';
    var d30 = new Date(today);
    d30.setDate(d30.getDate() + 30);
    var d60 = new Date(today);
    d60.setDate(d60.getDate() + 60);
    var exp = new Date(dateStr);
    if (exp <= d30) return 'badge-overdue';
    if (exp <= d60) return 'badge-in_progress';
    return 'badge-scheduled';
  }
  function expiryLabel(dateStr, today) {
    if (!dateStr) return 'No date';
    if (dateStr < today) return 'Overdue';
    var d30 = new Date(today);
    d30.setDate(d30.getDate() + 30);
    var d60 = new Date(today);
    d60.setDate(d60.getDate() + 60);
    var exp = new Date(dateStr);
    if (exp <= d30) return 'Due within 30 days';
    if (exp <= d60) return 'Due within 60 days';
    return 'OK';
  }
  function catLabel(key) {
    var c = CATEGORIES.find(function(x) { return x.key === key; });
    return c ? c.label : key;
  }
%>
<div class="page-header">
  <h1>Renewals/Documents</h1>
  <% if (isAdmin && tab !== 'documents') { %>
    <button type="button" class="btn btn-primary" id="renewal-add-open">+ Add Renewal</button>
  <% } else if (isAdmin) { %>
    <button type="button" class="btn btn-primary" id="document-add-open">+ Add Document</button>
  <% } %>
</div>

<div class="sched-view-tabs">
  <a href="/renewals" class="<%= tab !== 'documents' ? 'active' : '' %>">Renewals</a>
  <a href="/renewals?tab=documents" class="<%= tab === 'documents' ? 'active' : '' %>">Documents/Licensing</a>
</div>

<%
  // Shared by both tabs' filter bars below. overrides can set category,
  // employee and/or tab explicitly (including '' to clear one); anything
  // left out keeps the page's current value instead.
  function renewalsUrl(overrides) {
    overrides = overrides || {};
    var cat = 'category' in overrides ? overrides.category : category;
    var emp = 'employee' in overrides ? overrides.employee : employee;
    var t = 'tab' in overrides ? overrides.tab : tab;
    var qs = [];
    if (t === 'documents') qs.push('tab=documents');
    if (cat) qs.push('category=' + cat);
    if (emp) qs.push('employee=' + emp);
    return '/renewals' + (qs.length ? '?' + qs.join('&') : '');
  }
%>

<% if (isAdmin) { %>
<!-- Manage Categories Modal - shared by the Renewals and Documents/Licensing
     tabs' filter bars and "+ Add category..." selects, so it only needs to
     exist once regardless of which tab is active. -->
<div id="manage-cat-modal" class="modal-backdrop" hidden>
  <div class="modal" role="dialog" aria-modal="true" aria-labelledby="manage-cat-title" style="max-width:420px;">
    <button type="button" class="modal-close" id="manage-cat-close" aria-label="Close">&times;</button>
    <h2 id="manage-cat-title">Manage Categories</h2>
    <ul style="list-style:none;padding:0;margin:0 0 1rem;">
      <% CATEGORIES.forEach(c => { %>
        <li style="display:flex;align-items:center;justify-content:space-between;padding:0.4rem 0;border-bottom:1px solid var(--color-border);">
          <span><%= c.label %></span>
          <form method="post" action="/renewals/categories/<%= c.id %>/delete"
                data-confirm="Delete the &quot;<%= c.label %>&quot; category? Renewals and documents already using it will keep the old value." style="margin:0;">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="context-menu-item context-menu-danger" style="padding:0.15rem 0.5rem;font-size:0.8rem;">Delete</button>
          </form>
        </li>
      <% }) %>
    </ul>
    <form method="post" action="/renewals/categories" style="display:flex;gap:0.5rem;">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="text" name="label" required placeholder="New category name" style="flex:1;">
      <button type="submit" class="btn btn-primary" style="white-space:nowrap;">Add</button>
    </form>
  </div>
</div>
<script>
(function () {
  var manageCatModal = document.getElementById('manage-cat-modal');
  document.getElementById('manage-cat-close').addEventListener('click', function () { manageCatModal.hidden = true; });
  manageCatModal.addEventListener('click', function (e) { if (e.target === manageCatModal) manageCatModal.hidden = true; });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !manageCatModal.hidden) manageCatModal.hidden = true; });

  // Wires a category <select>'s "+ Add category..." option (value
  // "__manage__") to open the modal above instead of actually selecting it -
  // shared by the Renewal and Document add/edit forms below.
  window.wireManageCategoryOption = function (select) {
    select.addEventListener('change', function () {
      if (select.value === '__manage__') {
        select.value = select.dataset.prev || select.options[0].value;
        var ownerModal = select.closest('.modal-backdrop');
        if (ownerModal) ownerModal.hidden = true;
        manageCatModal.hidden = false;
      } else {
        select.dataset.prev = select.value;
      }
    });
  };
})();
</script>
<% } %>

<% if (tab !== 'documents') { %>
<div class="filters">
  <a class="<%= category === '' ? 'active' : '' %>" href="<%= renewalsUrl({ category: '' }) %>">All</a>
  <% CATEGORIES.forEach(c => { %>
    <a class="<%= category === c.key ? 'active' : '' %>" href="<%= renewalsUrl({ category: c.key }) %>"><%= c.label %></a>
  <% }) %>
</div>

<form method="get" class="card" style="display:flex;gap:1rem;flex-wrap:wrap;align-items:flex-end;">
  <input type="hidden" name="category" value="<%= category %>">
  <label style="flex:1;min-width:200px;">
    Staff member
    <select name="employee" onchange="this.form.requestSubmit()">
      <option value="">Anyone</option>
      <% users.forEach(u => { %>
        <option value="<%= u.id %>" <%= String(employee) === String(u.id) ? 'selected' : '' %>><%= u.name %></option>
      <% }) %>
    </select>
  </label>
  <% if (employee) { %><a href="<%= renewalsUrl({ employee: '' }) %>" class="btn btn-secondary btn-sm">Clear</a><% } %>
</form>

<% if (!items.length) { %>
