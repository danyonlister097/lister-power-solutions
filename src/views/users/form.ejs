<%- include('../partials/header', { title: title }) %>
<h1><%= title %></h1>

<form method="post" action="<%= targetUser.id ? `/users/${targetUser.id}` : '/users' %>" class="card">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <% if (error) { %>
    <div class="flash flash-error">
      <%= error %>
      <% if (typeof existingUser !== 'undefined' && existingUser) { %>
        <a href="/users/<%= existingUser.id %>/edit">Edit <%= existingUser.name %> instead</a>
      <% } %>
    </div>
  <% } %>

  <% if (targetUser.locked_at) { %>
    <div class="flash flash-error" style="display:flex;align-items:center;justify-content:space-between;gap:1rem;">
      <span>This account is locked after too many failed login attempts.</span>
      <form method="post" action="/users/<%= targetUser.id %>/unlock" style="margin:0;">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit" class="btn btn-secondary btn-sm">Unlock account</button>
      </form>
    </div>
  <% } %>

  <label>
    Name *
    <input type="text" name="name" value="<%= targetUser.name || '' %>" required autofocus>
  </label>

  <label>
    Email *
    <input type="email" name="email" value="<%= targetUser.email || '' %>" required>
  </label>

  <div class="form-row form-row-2">
    <label>
      Role
      <select name="role">
        <option value="trade" <%= (targetUser.role || 'trade') === 'trade' ? 'selected' : '' %>>Trade</option>
        <option value="apprentice" <%= targetUser.role === 'apprentice' ? 'selected' : '' %>>Apprentice</option>
        <option value="admin" <%= targetUser.role === 'admin' ? 'selected' : '' %>>Admin</option>
      </select>
    </label>
    <label>
      Rate <span style="font-weight:400;">(admin-only, used for labour cost totals)</span>
      <select name="hourly_rate" id="user-rate-select">
        <option value="" <%= targetUser.hourly_rate == null ? 'selected' : '' %>>No rate set</option>
        <% rateCategories.forEach(function (c) { %>
          <option value="<%= c.rate %>" <%= String(targetUser.hourly_rate) === String(c.rate) ? 'selected' : '' %>><%= c.label %> &mdash; $<%= c.rate %>/hr</option>
        <% }) %>
        <% if (currentUser.role === 'admin') { %>
          <option value="__manage__" style="color:var(--color-primary);">+ Add rate category&hellip;</option>
        <% } %>
      </select>
    </label>
  </div>

  <% if (targetUser.id) { %>
    <label>
      <input type="checkbox" name="active" value="1" style="display:inline-block;width:auto;" <%= targetUser.active ? 'checked' : '' %>>
      Active
    </label>
    <label>
      New password <span style="font-weight:400;">(leave blank to keep current password)</span>
      <input type="password" name="password" id="user-password-field" minlength="8" autocomplete="new-password">
    </label>
  <% } else { %>
    <label>
      Password *
      <input type="password" name="password" required minlength="8" autocomplete="new-password">
    </label>
  <% } %>

  <div class="form-row form-row-2">
    <label>
      Date of Birth <span style="font-weight:400;">(birthday milestone)</span>
      <input type="date" name="date_of_birth" value="<%= targetUser.date_of_birth || '' %>">
    </label>
    <label>
      Employment Start Date <span style="font-weight:400;">(work anniversary milestone)</span>
      <input type="date" name="employment_start_date" value="<%= targetUser.employment_start_date || '' %>">
    </label>
  </div>

  <div class="section-heading" style="margin-top:1.5rem;">Contact details</div>

  <div class="form-row form-row-2">
    <label>
      Personal phone
      <input type="tel" name="phone_personal" value="<%= targetUser.phone_personal || '' %>">
    </label>
    <label>
      Work phone
      <input type="tel" name="phone_work" value="<%= targetUser.phone_work || '' %>">
    </label>
  </div>

  <div class="form-row form-row-3">
    <label>
      Emergency contact name
      <input type="text" name="emergency_contact_name" value="<%= targetUser.emergency_contact_name || '' %>">
    </label>
    <label>
      Emergency contact phone
      <input type="tel" name="emergency_contact_phone" value="<%= targetUser.emergency_contact_phone || '' %>">
    </label>
    <label>
      Relationship
      <input type="text" name="emergency_contact_relation" value="<%= targetUser.emergency_contact_relation || '' %>" placeholder="e.g. Spouse, Parent">
    </label>
  </div>

  <div class="section-heading" style="margin-top:1.5rem;">Home address</div>

  <label>
    Street
    <input type="text" name="address_street" value="<%= targetUser.address_street || '' %>" placeholder="e.g. 12 Example St">
  </label>

  <div class="form-row form-row-3">
    <label>
      City / Suburb
      <input type="text" name="address_city" value="<%= targetUser.address_city || '' %>">
    </label>
    <label>
      State
      <input type="text" name="address_state" value="<%= targetUser.address_state || '' %>" placeholder="e.g. QLD">
    </label>
    <label>
      Postcode
      <input type="text" name="address_postcode" value="<%= targetUser.address_postcode || '' %>" inputmode="numeric" maxlength="4">
    </label>
  </div>

  <div class="permissions-field">
    <div class="permissions-label">
      Page &amp; tool access
      <span id="permissions-admin-note" style="font-weight:400;<%= (targetUser.role || 'trade') === 'admin' ? '' : 'display:none;' %>">
        Admins always have full access to everything, regardless of these boxes.
      </span>
    </div>
    <div id="permissions-grid" data-defaults='<%- JSON.stringify(DEFAULT_KEYS_BY_ROLE) %>' data-is-new="<%= targetUser.id ? '0' : '1' %>">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:0.4rem;">
        <div style="font-size:0.8rem;font-weight:600;text-transform:uppercase;letter-spacing:0.05em;color:var(--color-text-muted);">Level 1 Access</div>
        <label class="permissions-item" style="margin:0;font-size:0.85rem;font-weight:500;">
          <input type="checkbox" class="perm-select-all" data-group="1" style="display:inline-block;width:auto;">
          Tick all
        </label>
      </div>
      <div class="permissions-grid" data-group="1" style="margin-bottom:1rem;">
        <% PERMISSIONS.filter(p => p.group === 1).forEach(p => { %>
          <label class="permissions-item">
            <input type="checkbox" name="permissions" value="<%= p.key %>" <%= selectedPermissions.includes(p.key) ? 'checked' : '' %>>
            <%= p.label %>
          </label>
        <% }) %>
      </div>
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:0.4rem;">
        <div style="font-size:0.8rem;font-weight:600;text-transform:uppercase;letter-spacing:0.05em;color:var(--color-text-muted);">Level 2 Access</div>
        <label class="permissions-item" style="margin:0;font-size:0.85rem;font-weight:500;">
          <input type="checkbox" class="perm-select-all" data-group="2" style="display:inline-block;width:auto;">
          Tick all
        </label>
      </div>
      <div class="permissions-grid" data-group="2">
        <% PERMISSIONS.filter(p => p.group === 2).forEach(p => { %>
          <label class="permissions-item">
            <input type="checkbox" name="permissions" value="<%= p.key %>" <%= selectedPermissions.includes(p.key) ? 'checked' : '' %>>
            <%= p.label %>
          </label>
        <% }) %>
      </div>
    </div>
  </div>
  <script>
  (function () {
    function getGroupBoxes(group) {
      return Array.from(document.querySelectorAll('.permissions-grid[data-group="' + group + '"] input[type="checkbox"]'));
    }
    function syncSelectAll(selectAll) {
      var boxes = getGroupBoxes(selectAll.getAttribute('data-group'));
      var checkedCount = boxes.filter(function (b) { return b.checked; }).length;
      selectAll.checked = checkedCount === boxes.length;
      selectAll.indeterminate = checkedCount > 0 && checkedCount < boxes.length;
    }
    document.querySelectorAll('.perm-select-all').forEach(function (selectAll) {
      var group = selectAll.getAttribute('data-group');
      // Set initial state
      syncSelectAll(selectAll);
      // Toggle all on click
      selectAll.addEventListener('change', function () {
        getGroupBoxes(group).forEach(function (b) { b.checked = selectAll.checked; });
      });
      // Keep "tick all" in sync when individual boxes change
      getGroupBoxes(group).forEach(function (b) {
        b.addEventListener('change', function () { syncSelectAll(selectAll); });
      });
    });
  })();
  </script>

  <div class="actions">
    <button type="submit" class="btn btn-primary">Save employee</button>
    <a class="btn btn-secondary" href="/users">Cancel</a>
  </div>
</form>

<script>
  (function () {
    var grid = document.getElementById('permissions-grid');
    var roleSelect = document.querySelector('select[name="role"]');
    var adminNote = document.getElementById('permissions-admin-note');
    if (!grid || !roleSelect) return;

    var defaults = JSON.parse(grid.getAttribute('data-defaults'));
    var isNew = grid.getAttribute('data-is-new') === '1';

    roleSelect.addEventListener('change', function () {
      adminNote.style.display = roleSelect.value === 'admin' ? '' : 'none';
      // Re-applying "smart" defaults only makes sense while there's nothing
      // to lose yet - on an edit, the admin may have deliberately customised
      // these away from the role's defaults, so switching role shouldn't
      // silently wipe that out.
      if (!isNew) return;
      var keys = defaults[roleSelect.value] || [];
      grid.querySelectorAll('input[type="checkbox"]').forEach(function (cb) {
        cb.checked = keys.indexOf(cb.value) !== -1;
      });
    });
  })();
</script>

<% if (targetUser.id) { %>
  <script>
    // Password managers/autofill can populate this field without the admin
    // meaning to change anything - a silent password change on save would
    // lock the account owner out with no obvious cause, so confirm first.
    (function () {
      var form = document.getElementById('user-password-field').closest('form');
      var confirmed = false;
      form.addEventListener('submit', function (e) {
        var field = document.getElementById('user-password-field');
        if (!field.value || confirmed) return;
        e.preventDefault();
        window.showConfirm(
          'Change password?',
          'This will change the password for "<%= targetUser.name %>". They\'ll need the new password to log in next time. Continue?',
          function () {
            confirmed = true;
            if (form.requestSubmit) form.requestSubmit();
            else form.submit();
          },
          { okLabel: 'Change password', variant: 'primary' }
        );
      });
    })();
  </script>
<% } %>

<% if (targetUser.id) { %>
  <form method="post" action="/users/<%= targetUser.id %>/delete" class="card"
        data-confirm="Remove this employee? They will no longer be able to log in or be assigned jobs.">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <button type="submit" class="btn btn-danger btn-sm">Remove employee</button>
  </form>
<% } %>

<% if (currentUser.role === 'admin') { %>
  <% var _rateReturnTo = targetUser.id ? `/users/${targetUser.id}/edit` : '/users/new'; %>
  <!-- Manage Rate Categories Modal -->
  <div id="manage-rate-cat-modal" class="modal-backdrop" hidden>
    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="manage-rate-cat-title" style="max-width:420px;">
      <button type="button" class="modal-close" id="manage-rate-cat-close" aria-label="Close">&times;</button>
      <h2 id="manage-rate-cat-title">Manage rate categories</h2>
      <ul style="list-style:none;padding:0;margin:0 0 1rem;">
        <% rateCategories.forEach(function (c) { %>
          <li style="display:flex;align-items:center;justify-content:space-between;padding:0.4rem 0;border-bottom:1px solid var(--color-border);">
            <span><%= c.label %> &mdash; $<%= c.rate %>/hr</span>
            <form method="post" action="/users/rate-categories/<%= c.id %>/delete"
                  data-confirm="Delete the &quot;<%= c.label %>&quot; rate category? Employees already using it will keep their current rate." style="margin:0;">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="returnTo" value="<%= _rateReturnTo %>">
              <button type="submit" class="context-menu-item context-menu-danger" style="padding:0.15rem 0.5rem;font-size:0.8rem;">Delete</button>
            </form>
          </li>
        <% }) %>
      </ul>
      <form method="post" action="/users/rate-categories" style="display:flex;gap:0.5rem;flex-wrap:wrap;">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="returnTo" value="<%= _rateReturnTo %>">
        <input type="text" name="label" required placeholder="Category name" style="flex:1;min-width:8rem;">
        <input type="number" name="rate" required step="0.01" min="0" placeholder="$/hr" style="width:6rem;">
        <button type="submit" class="btn btn-primary" style="white-space:nowrap;">Add</button>
      </form>
    </div>
  </div>
  <script>
    (function () {
      var manageModal = document.getElementById('manage-rate-cat-modal');
      document.getElementById('manage-rate-cat-close').addEventListener('click', function () { manageModal.hidden = true; });
      manageModal.addEventListener('click', function (e) { if (e.target === manageModal) manageModal.hidden = true; });

      var rateSelect = document.getElementById('user-rate-select');
      rateSelect.dataset.prev = rateSelect.value;
      rateSelect.addEventListener('change', function () {
        if (rateSelect.value === '__manage__') {
          rateSelect.value = rateSelect.dataset.prev || '';
          manageModal.hidden = false;
        } else {
          rateSelect.dataset.prev = rateSelect.value;
        }
      });
    })();
  </script>
<% } %>
<%- include('../partials/footer') %>
