<%- include('../partials/header', { title: 'Customers' }) %>
<div class="page-header">
  <h1>Customers</h1>
  <a class="btn btn-primary" href="/customers/new">+ New customer</a>
</div>

<div class="card">
  <label>
    Search by name
    <input type="text" id="customer-search" value="<%= q %>" placeholder="Start typing a customer name..." autocomplete="off">
  </label>
</div>

<% if (customers.length === 0) { %>
  <div class="empty-state" id="customer-empty">No customers found.</div>
<% } else { %>
  <div class="section-heading" id="customer-count"><%= customers.length %> customer<%= customers.length === 1 ? '' : 's' %></div>
  <div class="empty-state" id="customer-empty" style="display:none;">No customers match your search.</div>
  <ul class="list" id="customer-list">
    <% customers.forEach(c => { %>
      <li data-name="<%= c.name.toLowerCase() %>">
        <a class="list-item" href="/customers/<%= c.id %>">
          <span>
            <span class="list-item-title"><%= c.name %></span><br>
            <span class="list-item-meta"><%= [c.address_city, c.address_state].filter(Boolean).join(', ') || 'No address on file' %></span>
          </span>
          <span class="list-item-meta"><%= c.phone || c.email || '' %></span>
        </a>
      </li>
    <% }) %>
  </ul>

  <div class="filters" style="justify-content:flex-end;align-items:center;gap:1rem;border:none;padding:0.5rem 0;">
    <label style="display:flex;align-items:center;gap:0.5rem;font-size:0.85rem;color:var(--color-muted);">
      Per page
      <select id="customer-page-size" style="width:auto;">
        <option value="20">20</option>
        <option value="40">40</option>
        <option value="80">80</option>
      </select>
    </label>
  </div>
  <div class="inventory-pagination" id="customer-pagination" hidden>
    <button type="button" class="btn btn-secondary btn-sm" id="customer-prev-page">&larr; Previous</button>
    <span id="customer-page-info" class="text-muted"></span>
    <button type="button" class="btn btn-secondary btn-sm" id="customer-next-page">Next &rarr;</button>
  </div>
<% } %>

<script>
  (function () {
    var input = document.getElementById('customer-search');
    var list = document.getElementById('customer-list');
    var empty = document.getElementById('customer-empty');
    var count = document.getElementById('customer-count');
    var pageSizeSelect = document.getElementById('customer-page-size');
    var prevBtn = document.getElementById('customer-prev-page');
    var nextBtn = document.getElementById('customer-next-page');
    var pageInfo = document.getElementById('customer-page-info');
    var pager = document.getElementById('customer-pagination');
    if (!input || !list) return;

    var items = Array.from(list.querySelectorAll('li'));
    var currentPage = 1;

    function matchingItems() {
      var q = input.value.toLowerCase().trim();
      if (!q) return items;
      return items.filter(function (li) { return li.dataset.name.indexOf(q) !== -1; });
    }

    function render() {
      var matched = matchingItems();
      var pageSize = Number.parseInt(pageSizeSelect.value, 10) || 20;
      var totalPages = Math.max(1, Math.ceil(matched.length / pageSize));
      if (currentPage > totalPages) currentPage = totalPages;
      if (currentPage < 1) currentPage = 1;

      var start = (currentPage - 1) * pageSize;
      var visible = new Set(matched.slice(start, start + pageSize));

      items.forEach(function (li) { li.style.display = visible.has(li) ? '' : 'none'; });

      empty.style.display = matched.length === 0 ? '' : 'none';
      list.style.display = matched.length === 0 ? 'none' : '';
      count.textContent = matched.length + ' customer' + (matched.length === 1 ? '' : 's');
      pageInfo.textContent = 'Page ' + currentPage + ' of ' + totalPages;
      prevBtn.disabled = currentPage <= 1;
      nextBtn.disabled = currentPage >= totalPages;
      pager.hidden = totalPages <= 1;
    }

    function resetToTop() {
      currentPage = 1;
      render();
    }

    input.addEventListener('input', resetToTop);
    pageSizeSelect.addEventListener('change', resetToTop);
    prevBtn.addEventListener('click', function () { currentPage--; render(); });
    nextBtn.addEventListener('click', function () { currentPage++; render(); });

    render();
  })();
</script>
<%- include('../partials/footer') %>
