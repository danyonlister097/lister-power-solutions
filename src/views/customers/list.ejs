<%- include('../partials/header', { title: 'Customers' }) %>
<div class="page-header">
  <h1>Customers</h1>
  <a class="btn btn-primary" href="/customers/new">+ New customer</a>
</div>

<div class="card">
  <label>
    Search by name
    <input type="text" id="customer-search" value="<%= q %>" placeholder="Start typing a customer name..." autocomplete="off">
  </label>
</div>

<% if (customers.length === 0) { %>
  <div class="empty-state" id="customer-empty">No customers found.</div>
<% } else { %>
  <div class="empty-state" id="customer-empty" style="display:none;">No customers match your search.</div>
  <ul class="list" id="customer-list">
    <% customers.forEach(c => { %>
      <li data-name="<%= c.name.toLowerCase() %>">
        <a class="list-item" href="/customers/<%= c.id %>">
          <span>
            <span class="list-item-title"><%= c.name %></span><br>
            <span class="list-item-meta"><%= [c.address_city, c.address_state].filter(Boolean).join(', ') || 'No address on file' %></span>
          </span>
          <span class="list-item-meta"><%= c.phone || c.email || '' %></span>
        </a>
      </li>
    <% }) %>
  </ul>
<% } %>

<script>
  (function () {
    var input = document.getElementById('customer-search');
    var list  = document.getElementById('customer-list');
    var empty = document.getElementById('customer-empty');
    if (!input || !list) return;

    var items = Array.from(list.querySelectorAll('li'));

    input.addEventListener('input', function () {
      var q = input.value.toLowerCase().trim();
      var visible = 0;
      items.forEach(function (li) {
        var match = !q || li.dataset.name.indexOf(q) !== -1;
        li.style.display = match ? '' : 'none';
        if (match) visible++;
      });
      empty.style.display = visible === 0 ? '' : 'none';
      list.style.display  = visible === 0 ? 'none' : '';
    });

    // Pre-filter if page loaded with a ?q= value
    if (input.value) input.dispatchEvent(new Event('input'));
  })();
</script>
<%- include('../partials/footer') %>
