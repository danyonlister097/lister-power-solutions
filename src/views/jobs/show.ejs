<%- include('../partials/header', { title: job.title }) %>
<div class="page-header">
  <h1><%= job.title %></h1>
  <div class="actions">
    <span class="badge badge-<%= job.status %>"><%= job.status.replace('_', ' ') %></span>
    <a class="page-close" href="<%= closeUrl %>" aria-label="Close" title="Close">&times;</a>
  </div>
</div>

<div class="card">
  <dl class="detail-grid">
    <dt>Customer</dt>
    <dd>
      <% if (currentUser.role === 'admin') { %>
        <a href="/customers/<%= job.customer_id %>"><%= job.customer_name %></a>
      <% } else { %>
        <%= job.customer_name %>
      <% } %>
    </dd>
    <% if (job.category) { %>
      <dt>Category</dt>
      <dd><%= job.category.replace(/-/g, ' ') %></dd>
    <% } %>
    <dt>Scheduled</dt>
    <dd>
      <% if (job.all_day) { %>
        <%= new Date(job.scheduled_start).toLocaleDateString('en-AU', { weekday: 'long', day: 'numeric', month: 'long' }) %> &middot; All day
      <% } else if (job.scheduled_start) {
        var _ss = new Date(job.scheduled_start);
        var _dateStr = _ss.toLocaleDateString('en-AU', { day: '2-digit', month: '2-digit', year: 'numeric' });
        var _startTime = _ss.toLocaleTimeString('en-AU', { hour: 'numeric', minute: '2-digit' });
      %><%= _dateStr %>, <%= _startTime %><% if (job.scheduled_end) {
          var _se = new Date(job.scheduled_end);
          var _endStr = (_ss.toDateString() === _se.toDateString())
            ? _se.toLocaleTimeString('en-AU', { hour: 'numeric', minute: '2-digit' })
            : _se.toLocaleString('en-AU', { day: '2-digit', month: '2-digit', year: 'numeric', hour: 'numeric', minute: '2-digit' });
        %> &ndash; <%= _endStr %><% } %>
      <% } else { %>Not scheduled<% } %>
      <% if (currentUser.role !== 'admin') { %>
        <span class="text-muted" style="font-size:0.78rem;display:block;margin-top:0.15rem;">Set by admin</span>
      <% } %>
    </dd>
    <% if (job.duration_minutes) { %>
      <dt>Expected duration</dt>
      <dd><%= job.duration_minutes < 60 ? job.duration_minutes + ' minutes' : (Math.round(job.duration_minutes / 6) / 10) + ' hours' %></dd>
    <% } %>
    <dt>Job site</dt>
    <dd>
      <% const site = [job.site_address_street, job.site_address_city, job.site_address_state, job.site_address_postcode].filter(Boolean).join(', '); %>
      <% if (site) { %>
        <a href="https://www.google.com/maps/search/?api=1&query=<%= encodeURIComponent(site) %>" target="_blank" rel="noopener"><%= site %></a>
      <% } else { %>—<% } %>
    </dd>
    <dt>Assigned to</dt>
    <dd><%= job.assigneeNames || 'Unassigned' %></dd>
    <% if (job.description) { %><dt>Description</dt><dd><%= job.description %></dd><% } %>
    <% if (job.notes) { %><dt>Notes</dt><dd><%= job.notes %></dd><% } %>
    <% if (linkedAssets.length) { %>
      <dt>Assets serviced</dt>
      <dd>
        <% linkedAssets.forEach(function (a, i) { %><% if (currentUser.role === 'admin') { %><a href="/customers/<%= job.customer_id %>/assets/<%= a.id %>"><%= a.name %></a><% } else { %><%= a.name %><% } %><%= i < linkedAssets.length - 1 ? ', ' : '' %><% }) %>
      </dd>
    <% } %>
  </dl>

  <% if (currentUser.role === 'admin') { %>
    <div class="actions">
      <a class="btn btn-secondary btn-sm" href="/jobs/<%= job.id %>/edit?returnTo=<%= encodeURIComponent(closeUrl) %>">Edit job</a>
      <form method="post" action="/jobs/<%= job.id %>/duplicate">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="returnTo" value="<%= closeUrl %>">
        <button type="submit" class="btn btn-secondary btn-sm">Duplicate</button>
      </form>
      <form method="post" action="/jobs/<%= job.id %>/delete" data-confirm="Delete this job? This cannot be undone.">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="returnTo" value="<%= closeUrl %>">
        <button type="submit" class="btn btn-danger btn-sm">Delete</button>
      </form>
    </div>
  <% } %>
</div>

<%
  function toLocalInput(isoStr) {
    if (!isoStr) return '';
    var d = new Date(isoStr);
    var pad = function(n) { return String(n).padStart(2, '0'); };
    return d.getFullYear() + '-' + pad(d.getMonth()+1) + '-' + pad(d.getDate()) +
           'T' + pad(d.getHours()) + ':' + pad(d.getMinutes());
  }
%>
<div class="card">
  <div class="page-header" style="margin-bottom:0.5rem;">
    <h2 style="margin:0;">Actual start time</h2>
    <% if (job.actual_start) { %><span class="badge badge-completed">&#10003; Logged</span><% } %>
  </div>
  <% if (!job.actual_start) { %>
    <p class="text-muted" style="font-size:0.85rem;margin:0 0 0.75rem;">Log the time you arrived and started on site.</p>
  <% } %>
  <form method="post" action="/jobs/<%= job.id %>/actual-start" class="form-row" data-preserve-scroll>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="returnTo" value="<%= closeUrl %>">
    <label>
      <%= job.actual_start ? 'Update' : 'Start time' %>
      <input type="datetime-local" name="actual_start" id="job-actual-start-input" value="<%= toLocalInput(job.actual_start) %>">
    </label>
    <div class="actions">
      <button type="submit" class="btn btn-primary btn-sm">Save start time</button>
    </div>
    <script>
      (function () {
        var input = document.getElementById('job-actual-start-input');
        var form = input.closest('form');
        input.addEventListener('click', function () {
          if (typeof input.showPicker === 'function') input.showPicker();
        });
        input.addEventListener('change', function () {
          if (form.requestSubmit) form.requestSubmit();
          else form.submit();
        });
      })();
    </script>
  </form>
</div>

<div class="card">
  <h2>Tech notes</h2>
  <% if (!techNotes.length) { %>
    <div class="empty-state">No notes yet.</div>
  <% } else { %>
    <ul class="list">
      <% techNotes.forEach(function (n) { %>
        <li>
          <span class="list-item" style="display:block;">
            <span class="list-item-meta"><%= n.user_name || 'Unknown user' %> &middot; <%= new Date(n.created_at).toLocaleString('en-AU', { day: '2-digit', month: '2-digit', year: 'numeric', hour: 'numeric', minute: '2-digit' }) %></span>
            <div style="margin-top:0.3rem;white-space:pre-wrap;"><%= n.body %></div>
            <form method="post" action="/jobs/<%= job.id %>/tech-notes/<%= n.id %>/delete" data-confirm="Remove this note?" data-preserve-scroll style="margin-top:0.4rem;">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="returnTo" value="<%= closeUrl %>">
              <button type="submit" class="btn-link" style="font-size:0.8rem;">Remove</button>
            </form>
          </span>
        </li>
      <% }) %>
    </ul>
  <% } %>

  <form method="post" action="/jobs/<%= job.id %>/tech-notes" data-preserve-scroll style="margin-top:0.75rem;">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="returnTo" value="<%= closeUrl %>">
    <label>
      Add a note
      <textarea name="body" rows="2" placeholder="Any comments or details about this job..." required></textarea>
    </label>
    <div class="actions">
      <button type="submit" class="btn btn-primary btn-sm">Add note</button>
    </div>
  </form>
</div>

<div class="card">
  <h2>Photos</h2>
  <% if (attachments.length === 0) { %>
    <div class="empty-state"><%= job.photos_na ? 'N/A — no photos required for this job.' : 'No photos yet.' %></div>
  <% } else { %>
    <div class="attachment-grid">
      <% attachments.forEach(a => { %>
        <div class="attachment-item">
          <a href="/jobs/<%= job.id %>/attachments/<%= a.id %>" target="_blank" rel="noopener">
            <img src="/jobs/<%= job.id %>/attachments/<%= a.id %>" alt="<%= a.original_name %>">
          </a>
          <form method="post" action="/jobs/<%= job.id %>/attachments/<%= a.id %>/delete"
                data-confirm="Remove this photo?" data-preserve-scroll>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="returnTo" value="<%= closeUrl %>">
            <button type="submit" class="attachment-delete" aria-label="Remove photo">&times;</button>
          </form>
        </div>
      <% }) %>
    </div>
  <% } %>

  <form method="post" action="/jobs/<%= job.id %>/attachments" enctype="multipart/form-data" class="attachment-upload-form" id="attachment-upload-form" data-preserve-scroll>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="returnTo" value="<%= closeUrl %>">
    <label>
      Add photos
      <input type="file" name="photos" accept="image/*" multiple>
    </label>
    <button type="submit" class="btn btn-primary btn-sm">Upload</button>
  </form>
  <script>
    (function () {
      // Vercel's serverless functions reject any request body over ~4.5MB
      // with a 413 - a single form submit bundling several full-size phone
      // photos together blows straight through that even though each photo
      // is fine on its own. Uploading one at a time keeps every individual
      // request well under the limit.
      var form = document.getElementById('attachment-upload-form');
      var fileInput = form.querySelector('input[type="file"]');
      var submitBtn = form.querySelector('button[type="submit"]');
      var csrfInput = form.querySelector('input[name="_csrf"]');
      var returnToInput = form.querySelector('input[name="returnTo"]');

      form.addEventListener('submit', function (e) {
        var files = fileInput.files;
        if (!files || !files.length) return; // nothing selected - let the plain submit show the server's own message

        e.preventDefault();
        submitBtn.disabled = true;
        var originalText = submitBtn.textContent;
        var failed = [];
        var i = 0;

        function uploadNext() {
          if (i >= files.length) {
            submitBtn.disabled = false;
            submitBtn.textContent = originalText;
            if (failed.length) {
              alert(
                (files.length - failed.length) + ' of ' + files.length + ' photo' + (files.length > 1 ? 's' : '') +
                ' uploaded. Failed: ' + failed.join(', ') + ' - try again, maybe one at a time if it keeps happening.'
              );
            }
            window.location.reload();
            return;
          }

          var file = files[i];
          submitBtn.textContent = 'Uploading ' + (i + 1) + ' of ' + files.length + '…';

          var fd = new FormData();
          fd.append('_csrf', csrfInput.value);
          if (returnToInput) fd.append('returnTo', returnToInput.value);
          fd.append('photos', file);

          fetch(form.action, { method: 'POST', body: fd })
            .then(function (res) { if (!res.ok) failed.push(file.name); })
            .catch(function () { failed.push(file.name); })
            .finally(function () {
              i++;
              uploadNext();
            });
        }

        uploadNext();
      });
    })();
  </script>
  <form method="post" action="/jobs/<%= job.id %>/na-flags" data-preserve-scroll style="margin-top:0.75rem;">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="returnTo" value="<%= closeUrl %>">
    <input type="hidden" name="stock_na" value="<%= job.stock_na ? '1' : '0' %>">
    <label class="toggle-label">
      <span class="text-muted" style="font-size:0.85rem;">N/A — no photos required</span>
      <span class="toggle-switch">
        <input type="checkbox" name="photos_na" value="1" <%= job.photos_na ? 'checked' : '' %> onchange="this.form.submit()">
        <span class="toggle-slider"></span>
      </span>
    </label>
  </form>
</div>

<div class="card">
  <div class="page-header" style="margin-bottom: 0.75rem;">
    <h2 style="margin: 0;">Forms &amp; certificates</h2>
    <a class="btn btn-secondary btn-sm" href="/forms?forJob=<%= job.id %>">+ Add form</a>
  </div>
  <p class="text-muted" style="font-size:0.85rem;margin:0 0 0.75rem;">Open a form to fill it in with your phone's PDF app (e.g. Adobe Acrobat's Fill &amp; Sign) or on a computer, save it, then upload the completed version here.</p>
  <% if (jobForms.length === 0) { %>
    <div class="empty-state">No forms attached to this job yet.</div>
  <% } else { %>
    <ul class="list">
      <% jobForms.forEach(f => { %>
        <li>
          <span class="list-item">
            <span>
              <span class="list-item-title"><%= f.name %></span><br>
              <span class="list-item-meta"><%= new Date(f.updated_at).toLocaleString('en-AU', { day: '2-digit', month: '2-digit', year: 'numeric', hour: 'numeric', minute: '2-digit' }) %></span>
            </span>
            <span class="actions">
              <span class="badge <%= f.completed ? 'badge-completed' : 'badge-scheduled' %>"><%= f.completed ? 'completed' : 'blank' %></span>
              <a class="btn btn-secondary btn-sm" href="/forms/job/<%= f.id %>/download" target="_blank" rel="noopener">View</a>
              <button type="button" class="btn btn-secondary btn-sm job-form-upload-toggle" data-target="job-form-upload-<%= f.id %>">Upload completed</button>
              <form method="post" action="/forms/job/<%= f.id %>/delete" data-confirm="Remove this form from the job?" data-preserve-scroll>
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="btn-link">Remove</button>
              </form>
            </span>
          </span>
          <form method="post" action="/forms/job/<%= f.id %>/upload" enctype="multipart/form-data" id="job-form-upload-<%= f.id %>" class="job-form-upload-form" hidden data-preserve-scroll>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="file" name="file" accept=".pdf,.doc,.docx,.xls,.xlsx,image/jpeg,image/png" required>
            <button type="submit" class="btn btn-primary btn-sm">Save</button>
          </form>
        </li>
      <% }) %>
    </ul>
  <% } %>
</div>

<div class="card">
  <h2>Stock used</h2>
  <% if (stockAllocations.length === 0) { %>
    <div class="empty-state"><%= job.stock_na ? 'N/A — no stock used on this job.' : 'No stock allocated yet.' %></div>
  <% } else { %>
    <ul class="list">
      <% stockAllocations.forEach(a => { %>
        <li>
          <span class="list-item">
            <span class="list-item-title"><%= a.item_name %></span>
            <span class="actions" style="gap:0.5rem;align-items:center;flex-wrap:wrap;">
              <form method="post" action="/inventory/allocations/<%= a.id %>/update" data-preserve-scroll
                    style="display:flex;align-items:center;gap:0.25rem;margin:0;">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="button" class="qty-adj-btn" data-dir="-1" aria-label="Decrease"
                        style="width:1.8rem;height:1.8rem;border:1px solid var(--color-border);border-radius:4px;background:var(--color-surface);cursor:pointer;font-size:1rem;display:inline-flex;align-items:center;justify-content:center;flex-shrink:0;">−</button>
                <input type="number" name="quantity" value="<%= a.quantity %>" step="any" min="1" required
                       style="width:4rem;text-align:center;padding:0.2rem 0.3rem;-moz-appearance:textfield;"
                       onwheel="this.blur()">
                <button type="button" class="qty-adj-btn" data-dir="1" aria-label="Increase"
                        style="width:1.8rem;height:1.8rem;border:1px solid var(--color-border);border-radius:4px;background:var(--color-surface);cursor:pointer;font-size:1rem;display:inline-flex;align-items:center;justify-content:center;flex-shrink:0;">+</button>
                <span class="text-muted" style="font-size:0.85rem;white-space:nowrap;"><%= a.item_unit %></span>
                <button type="submit" style="display:none;" aria-hidden="true"></button>
              </form>
              <form method="post" action="/inventory/allocations/<%= a.id %>/delete" data-confirm="Remove this stock allocation? The quantity will be returned to inventory." data-preserve-scroll style="margin:0;">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="btn-link" style="color:var(--color-danger);">Remove</button>
              </form>
            </span>
          </span>
        </li>
      <% }) %>
    </ul>
    <script>
      (function () {
        document.querySelectorAll('.qty-adj-btn').forEach(function (btn) {
          btn.addEventListener('click', function () {
            var form = btn.closest('form');
            var input = form.querySelector('input[name="quantity"]');
            var current = parseFloat(input.value) || 0;
            var newVal = Math.max(parseFloat(input.min) || 0.01, current + parseFloat(btn.getAttribute('data-dir')));
            input.value = parseFloat(newVal.toFixed(4));
            form.requestSubmit ? form.requestSubmit() : form.submit();
          });
        });
      })();
    </script>
  <% } %>
  <% if (inventoryItems.length === 0) { %>
    <p class="text-muted">No inventory items set up yet. <a href="/inventory">Add some</a>.</p>
  <% } else { %>
    <form method="post" action="/inventory/allocate" class="form-row form-row-2" id="stock-allocate-form" data-preserve-scroll>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="job_id" value="<%= job.id %>">
      <input type="hidden" name="item_id" id="stock-item-id">
      <label class="autocomplete">
        Item
        <input type="text" id="stock-item-search" placeholder="Search inventory item..." autocomplete="off">
        <div id="stock-item-results" class="autocomplete-results" hidden></div>
      </label>
      <label>
        Quantity
        <input type="number" name="quantity" step="any" min="0.01" required>
      </label>
      <div class="actions" style="grid-column: 1 / -1;">
        <button type="submit" class="btn btn-primary btn-sm">Allocate to this job</button>
      </div>
    </form>
    <form method="post" action="/jobs/<%= job.id %>/na-flags" data-preserve-scroll style="margin-top:0.75rem;">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="returnTo" value="<%= closeUrl %>">
      <input type="hidden" name="photos_na" value="<%= job.photos_na ? '1' : '0' %>">
      <label class="toggle-label">
        <span class="text-muted" style="font-size:0.85rem;">N/A — no stock used on this job</span>
        <span class="toggle-switch">
          <input type="checkbox" name="stock_na" value="1" <%= job.stock_na ? 'checked' : '' %> onchange="this.form.submit()">
          <span class="toggle-slider"></span>
        </span>
      </label>
    </form>
    <script>
      (function () {
        var items = <%- JSON.stringify(inventoryItems.map((i) => ({ id: i.id, name: i.name, code: i.supplier_code || '', unit: i.unit, qty: i.quantity_on_hand }))) %>;
        var search = document.getElementById('stock-item-search');
        var hiddenId = document.getElementById('stock-item-id');
        var results = document.getElementById('stock-item-results');
        var form = document.getElementById('stock-allocate-form');

        function closeResults() {
          results.hidden = true;
          results.innerHTML = '';
        }

        search.addEventListener('input', function () {
          hiddenId.value = '';
          var q = search.value.trim().toLowerCase();
          if (!q) return closeResults();

          var matches = items.filter(function (i) {
            return i.name.toLowerCase().indexOf(q) !== -1 ||
              (i.code && i.code.toLowerCase().indexOf(q) !== -1);
          }).slice(0, 15);
          if (!matches.length) {
            results.innerHTML = '<div class="autocomplete-empty">No matching items</div>';
            results.hidden = false;
            return;
          }

          results.innerHTML = matches
            .map(function (i) {
              return '<div class="autocomplete-result" data-id="' + i.id + '" data-name="' + i.name.replace(/"/g, '&quot;') + '" data-qty="' + i.qty + '">' +
                i.name +
                (i.code ? ' <span class="autocomplete-meta">' + i.code + '</span>' : '') +
                ' <span class="autocomplete-meta">(' + i.qty + ' ' + i.unit + ' on hand)</span></div>';
            })
            .join('');
          results.hidden = false;
        });

        var qtyInput = form.querySelector('input[name="quantity"]');
        results.addEventListener('click', function (e) {
          var row = e.target.closest('.autocomplete-result');
          if (!row) return;
          hiddenId.value = row.getAttribute('data-id');
          search.value = row.getAttribute('data-name');
          qtyInput.max = row.getAttribute('data-qty');
          closeResults();
        });

        document.addEventListener('click', function (e) {
          if (e.target !== search && !results.contains(e.target)) closeResults();
        });

        form.addEventListener('submit', function (e) {
          if (!hiddenId.value) {
            e.preventDefault();
            search.focus();
            search.setCustomValidity('Please choose an item from the list.');
            search.reportValidity();
          } else {
            search.setCustomValidity('');
          }
        });
      })();
    </script>
  <% } %>
</div>

<% if (currentUser.role === 'admin') { %>
  <div class="card">
    <h2>Job costing</h2>
    <div class="leave-stats">
      <div class="leave-stat leave-stat-pending">
        <span class="leave-stat-value"><%= formatMoney(costing.quotedAmount) %></span>
        <span class="leave-stat-label">Quoted (ex GST)</span>
      </div>
      <div class="leave-stat leave-stat-pending">
        <span class="leave-stat-value"><%= formatMoney(costing.quotedAmount !== null ? costing.quotedAmount * 1.1 : null) %></span>
        <span class="leave-stat-label">Quoted (inc GST)</span>
      </div>
      <div class="leave-stat leave-stat-declined">
        <span class="leave-stat-value"><%= formatMoney(costing.totalCost) %></span>
        <span class="leave-stat-label">Total cost</span>
      </div>
      <div class="leave-stat leave-stat-approved">
        <span class="leave-stat-value"><%= formatMoney(costing.profit) %></span>
        <span class="leave-stat-label">Profit</span>
      </div>
    </div>

    <form method="post" action="/jobs/<%= job.id %>/costing/quote" class="form-row form-row-2" data-preserve-scroll>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="returnTo" value="<%= closeUrl %>">
      <label>
        Quoted amount ($) &mdash; ex GST
        <input type="number" name="quoted_amount" id="job-quoted-amount" step="0.01" value="<%= costing.quotedAmount !== null ? costing.quotedAmount : '' %>">
        <span id="job-quoted-amount-incgst" class="text-muted" style="font-size:0.8rem;display:block;margin-top:0.25rem;"></span>
      </label>
      <div class="actions">
        <button type="submit" class="btn btn-secondary btn-sm">Save quote</button>
      </div>
    </form>
    <script>
      (function () {
        var input = document.getElementById('job-quoted-amount');
        var hint = document.getElementById('job-quoted-amount-incgst');
        function updateHint() {
          var v = parseFloat(input.value);
          hint.textContent = Number.isFinite(v) ? '= $' + (v * 1.1).toFixed(2) + ' inc GST' : '';
        }
        input.addEventListener('input', updateHint);
        updateHint();
      })();
    </script>

    <div class="section-heading">Quotes</div>
    <% if (!costing.quoteFiles.length) { %>
      <p class="text-muted">No quote files attached yet.</p>
    <% } else { %>
      <ul class="list">
        <% costing.quoteFiles.forEach(function (f) { %>
          <li>
            <span class="list-item">
              <span>
                <span class="list-item-title"><%= f.original_name %></span><br>
                <span class="list-item-meta"><%= new Date(f.created_at).toLocaleString('en-AU', { day: '2-digit', month: '2-digit', year: 'numeric', hour: 'numeric', minute: '2-digit' }) %></span>
              </span>
              <span class="actions">
                <a class="btn btn-secondary btn-sm" href="/jobs/<%= job.id %>/costing/quote-files/<%= f.id %>" target="_blank" rel="noopener">View</a>
                <form method="post" action="/jobs/<%= job.id %>/costing/quote-files/<%= f.id %>/delete" data-confirm="Remove this quote file?" data-preserve-scroll style="margin:0;">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <input type="hidden" name="returnTo" value="<%= closeUrl %>">
                  <button type="submit" class="btn-link">Remove</button>
                </form>
              </span>
            </span>
          </li>
        <% }) %>
      </ul>
    <% } %>

    <form method="post" action="/jobs/<%= job.id %>/costing/quote-files" enctype="multipart/form-data" id="quote-file-upload-form" data-preserve-scroll style="margin-bottom:1.5rem;">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="returnTo" value="<%= closeUrl %>">
      <label>
        Add quote file(s) <span style="font-weight:400;">(PDF, Word, Excel, or image)</span>
        <input type="file" name="quote_files" accept=".pdf,.doc,.docx,.xls,.xlsx,image/*" multiple>
      </label>
      <button type="submit" class="btn btn-primary btn-sm">Upload</button>
    </form>
    <script>
      (function () {
        // Same one-at-a-time upload as Photos above - avoids Vercel's
        // ~4.5MB request-body limit when more than one file is selected.
        var form = document.getElementById('quote-file-upload-form');
        var fileInput = form.querySelector('input[type="file"]');
        var submitBtn = form.querySelector('button[type="submit"]');
        var csrfInput = form.querySelector('input[name="_csrf"]');
        var returnToInput = form.querySelector('input[name="returnTo"]');

        form.addEventListener('submit', function (e) {
          var files = fileInput.files;
          if (!files || !files.length) return;

          e.preventDefault();
          submitBtn.disabled = true;
          var originalText = submitBtn.textContent;
          var failed = [];
          var i = 0;

          function uploadNext() {
            if (i >= files.length) {
              submitBtn.disabled = false;
              submitBtn.textContent = originalText;
              if (failed.length) {
                alert(
                  (files.length - failed.length) + ' of ' + files.length + ' file' + (files.length > 1 ? 's' : '') +
                  ' uploaded. Failed: ' + failed.join(', ') + ' - try again, maybe one at a time if it keeps happening.'
                );
              }
              window.location.reload();
              return;
            }

            var file = files[i];
            submitBtn.textContent = 'Uploading ' + (i + 1) + ' of ' + files.length + '…';

            var fd = new FormData();
            fd.append('_csrf', csrfInput.value);
            if (returnToInput) fd.append('returnTo', returnToInput.value);
            fd.append('quote_files', file);

            fetch(form.action, { method: 'POST', body: fd })
              .then(function (res) { if (!res.ok) failed.push(file.name); })
              .catch(function () { failed.push(file.name); })
              .finally(function () {
                i++;
                uploadNext();
              });
          }

          uploadNext();
        });
      })();
    </script>

    <div class="section-heading">Cost items</div>
    <% if (!costing.costItems.length) { %>
      <p class="text-muted">No cost items yet.</p>
    <% } else { %>
      <ul class="list">
        <% costing.costItems.forEach(i => { %>
          <li>
            <span class="list-item">
              <span>
                <span class="list-item-title"><%= i.description %></span><br>
                <span class="list-item-meta"><%= i.category %> &middot; <%= i.quantity %> &times; $<%= i.unit_cost.toFixed(2) %> = $<%= (i.quantity * i.unit_cost).toFixed(2) %></span>
              </span>
              <span class="actions">
                <button type="button" class="btn-link cost-item-edit-btn"
                        data-id="<%= i.id %>" data-category="<%= i.category %>"
                        data-description="<%= i.description %>" data-quantity="<%= i.quantity %>" data-unit-cost="<%= i.unit_cost %>">Edit</button>
                <form method="post" action="/jobs/<%= job.id %>/costing/items/<%= i.id %>/delete" data-confirm="Remove this cost item?" data-preserve-scroll style="margin:0;">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <input type="hidden" name="returnTo" value="<%= closeUrl %>">
                  <button type="submit" class="btn-link">Remove</button>
                </form>
              </span>
            </span>
          </li>
        <% }) %>
      </ul>
    <% } %>

    <form method="post" action="/jobs/<%= job.id %>/costing/items" class="form-row form-row-2" data-preserve-scroll id="cost-item-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="returnTo" value="<%= closeUrl %>">
      <label>
        Category
        <select name="category" id="cost-item-category">
          <% costing.categories.forEach(c => { %>
            <option value="<%= c %>" <%= c === 'labour' ? 'selected' : '' %>><%= c %></option>
          <% }) %>
        </select>
      </label>
      <label>
        Rate <span style="font-weight:400;">(optional &mdash; fills in Unit cost)</span>
        <select id="cost-item-rate">
          <option value="">&mdash; Select employee rate &mdash;</option>
          <% costing.employees.forEach(function(e) { if (e.hourly_rate != null) { %>
            <option value="<%= e.hourly_rate %>"><%= e.name %> &mdash; $<%= e.hourly_rate %>/hr</option>
          <% } }) %>
        </select>
      </label>
      <label style="grid-column: 1 / -1;">
        Description <span style="font-weight:400;" id="cost-item-desc-hint">(optional for labour)</span>
        <input type="text" name="description" placeholder="e.g. Danyon - 3.5 hrs" id="cost-item-description">
      </label>
      <label>
        Quantity
        <input type="number" name="quantity" step="any" value="1" required id="cost-item-quantity">
      </label>
      <label>
        Unit cost ($)
        <input type="number" name="unit_cost" step="0.01" required id="cost-item-unit-cost">
      </label>
      <div class="actions" style="grid-column: 1 / -1;">
        <button type="submit" class="btn btn-primary btn-sm" id="cost-item-submit-btn">Add cost item</button>
        <button type="button" class="btn btn-secondary btn-sm" id="cost-item-cancel-btn" hidden>Cancel edit</button>
      </div>
    </form>
    <script>
      (function () {
        var rateSelect = document.getElementById('cost-item-rate');
        var unitCost = document.getElementById('cost-item-unit-cost');
        rateSelect.addEventListener('change', function () {
          if (rateSelect.value) unitCost.value = rateSelect.value;
        });

        // Labour items are self-explanatory once you've picked a rate, so
        // description isn't forced the way it is for every other category.
        var categorySelect = document.getElementById('cost-item-category');
        var descInput = document.getElementById('cost-item-description');
        var descHint = document.getElementById('cost-item-desc-hint');
        function updateDescRequired() {
          var isLabour = categorySelect.value === 'labour';
          descInput.required = !isLabour;
          descHint.style.display = isLabour ? '' : 'none';
        }
        categorySelect.addEventListener('change', updateDescRequired);
        updateDescRequired();

        // --- Edit an existing cost item instead of deleting and re-adding ---
        var form = document.getElementById('cost-item-form');
        var quantityInput = document.getElementById('cost-item-quantity');
        var submitBtn = document.getElementById('cost-item-submit-btn');
        var cancelBtn = document.getElementById('cost-item-cancel-btn');
        var createAction = form.action;

        function resetToAddMode() {
          form.action = createAction;
          form.reset();
          updateDescRequired();
          submitBtn.textContent = 'Add cost item';
          cancelBtn.hidden = true;
        }

        document.addEventListener('click', function (e) {
          var btn = e.target.closest('.cost-item-edit-btn');
          if (!btn) return;
          form.action = '/jobs/<%= job.id %>/costing/items/' + btn.getAttribute('data-id');
          categorySelect.value = btn.getAttribute('data-category');
          descInput.value = btn.getAttribute('data-description');
          quantityInput.value = btn.getAttribute('data-quantity');
          unitCost.value = btn.getAttribute('data-unit-cost');
          updateDescRequired();
          submitBtn.textContent = 'Save changes';
          cancelBtn.hidden = false;
          form.scrollIntoView({ behavior: 'smooth', block: 'center' });
          descInput.focus();
        });

        cancelBtn.addEventListener('click', resetToAddMode);
      })();
    </script>

    <div class="section-heading">Invoicing notes</div>
    <form method="post" action="/jobs/<%= job.id %>/costing/invoicing-notes" id="invoicing-notes-form" data-preserve-scroll>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="returnTo" value="<%= closeUrl %>">
      <label>
        Anything the invoicing admin needs to know <span style="font-weight:400;">(PO numbers, special billing instructions, etc.)</span>
        <textarea name="invoicing_notes" id="invoicing-notes-input" rows="3" placeholder="e.g. Invoice to head office, not site address. PO# 4471."><%= costing.invoicingNotes || '' %></textarea>
      </label>
      <div class="actions" style="align-items:center;">
        <button type="submit" class="btn btn-secondary btn-sm">Save invoicing notes</button>
        <span id="invoicing-notes-status" class="text-muted" style="font-size:0.8rem;"></span>
      </div>
    </form>
    <script>
      (function () {
        // Clicking away from the notes box saves it in the background,
        // without a full page reload - the button stays as a fallback (and
        // for anyone who prefers it) but you don't have to remember to
        // click it.
        var input = document.getElementById('invoicing-notes-input');
        var form = document.getElementById('invoicing-notes-form');
        var status = document.getElementById('invoicing-notes-status');
        var csrfInput = form.querySelector('input[name="_csrf"]');
        var lastSaved = input.value;

        input.addEventListener('input', function () {
          status.textContent = '';
        });

        input.addEventListener('blur', function () {
          if (input.value === lastSaved) return;
          var valueToSave = input.value;
          status.textContent = 'Saving…';

          // This route has no multer middleware, so it only understands
          // application/x-www-form-urlencoded (what a plain form submit
          // sends) - a fetch() with a FormData body forces multipart/form-data
          // instead, which arrives as an empty req.body and fails CSRF.
          var body = '_csrf=' + encodeURIComponent(csrfInput.value) + '&invoicing_notes=' + encodeURIComponent(valueToSave);

          fetch(form.action, {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: body,
          })
            .then(function (res) {
              if (!res.ok) throw new Error('Save failed');
              lastSaved = valueToSave;
              status.textContent = 'Saved';
            })
            .catch(function () {
              status.textContent = 'Could not save - try the Save button.';
            });
        });

        form.addEventListener('submit', function () {
          lastSaved = input.value;
          status.textContent = '';
        });
      })();
    </script>
  </div>

<% } %>
<div class="card">
  <div class="page-header" style="margin-bottom:0.5rem;">
    <h2 style="margin:0;">Actual finish time</h2>
    <% if (job.actual_end) { %><span class="badge badge-completed">&#10003; Logged</span><% } %>
  </div>
  <% if (!job.actual_end) { %>
    <p class="text-muted" style="font-size:0.85rem;margin:0 0 0.75rem;">Log when you finished on site. Required before marking job as completed.</p>
  <% } %>
  <form method="post" action="/jobs/<%= job.id %>/actual-end" class="form-row" data-preserve-scroll>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="returnTo" value="<%= closeUrl %>">
    <label>
      <%= job.actual_end ? 'Update' : 'Finish time' %>
      <input type="datetime-local" name="actual_end" id="job-actual-end-input" value="<%= toLocalInput(job.actual_end) %>">
    </label>
    <div class="actions">
      <button type="submit" class="btn btn-primary btn-sm">Save finish time</button>
    </div>
    <script>
      (function () {
        var input = document.getElementById('job-actual-end-input');
        var form = input.closest('form');
        input.addEventListener('click', function () {
          if (typeof input.showPicker === 'function') input.showPicker();
        });
        input.addEventListener('change', function () {
          if (form.requestSubmit) form.requestSubmit();
          else form.submit();
        });
      })();
    </script>
  </form>
</div>

<div class="card">
  <h2>Update status</h2>
  <% if (job.status !== 'completed') { %>
    <% var _missingActuals = !job.actual_start || !job.actual_end; %>
    <% if (_missingActuals) { %>
      <p class="text-muted" style="font-size:0.85rem;margin:0 0 0.75rem;">&#9432; Record actual start and finish times above before marking as completed.</p>
    <% } %>
  <% } %>
  <form method="post" action="/jobs/<%= job.id %>/status" class="form-row form-row-2" data-preserve-scroll>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="returnTo" value="<%= closeUrl %>">
    <select name="status">
      <% STATUSES.forEach(s => { %>
        <option value="<%= s %>" <%= job.status === s ? 'selected' : '' %>><%= s.replace('_', ' ') %></option>
      <% }) %>
    </select>
    <button type="submit" class="btn btn-primary">Update status</button>
  </form>
</div>

<% if (currentUser.role === 'admin') { %>
  <div class="card">
    <h2>History</h2>
    <p class="list-item-meta" style="margin:0 0 1rem;">Created by <%= createdByName || 'Unknown user' %> &middot; <%= new Date(job.created_at).toLocaleString('en-AU', { day: '2-digit', month: '2-digit', year: 'numeric', hour: 'numeric', minute: '2-digit' }) %></p>
    <% if (jobHistory.length === 0) { %>
      <div class="empty-state">No edits recorded yet.</div>
    <% } else { %>
      <ul class="list">
        <% jobHistory.forEach(function (h) { %>
          <li>
            <span class="list-item" style="display:block;">
              <span class="list-item-meta"><%= h.userName || 'Unknown user' %> &middot; <%= new Date(h.createdAt).toLocaleString('en-AU', { day: '2-digit', month: '2-digit', year: 'numeric', hour: 'numeric', minute: '2-digit' }) %></span>
              <ul class="job-history-changes">
                <% h.changes.forEach(function (c) { %>
                  <li><strong><%= c.field %>:</strong> <%= c.from || '(none)' %> &rarr; <%= c.to || '(none)' %></li>
                <% }) %>
              </ul>
            </span>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </div>
<% } %>
