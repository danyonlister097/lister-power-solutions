<%- include('../partials/header', { title: 'Dashboard', wide: true }) %>
<div class="page-header">
  <h1>Dashboard</h1>
</div>

<div class="leave-stats">
  <div class="leave-stat leave-stat-pending">
    <span class="leave-stat-value"><%= jobsThisWeek %></span>
    <span class="leave-stat-label">Jobs this week</span>
  </div>
  <div class="leave-stat leave-stat-pending">
    <span class="leave-stat-value"><%= jobsToday %></span>
    <span class="leave-stat-label">Jobs today</span>
  </div>
  <div class="leave-stat leave-stat-approved">
    <span class="leave-stat-value"><%= formatMoney(revenueThisMonth) %></span>
    <span class="leave-stat-label">Revenue this month</span>
  </div>
  <div class="leave-stat <%= upcomingMaintenance.some(m => m.overdue) ? 'leave-stat-declined' : 'leave-stat-pending' %>">
    <span class="leave-stat-value"><%= upcomingMaintenance.length %></span>
    <span class="leave-stat-label">Vehicles &amp; equipment due for service</span>
  </div>
  <div class="leave-stat <%= overdueBillsCount ? 'leave-stat-declined' : (upcomingBills.length ? 'leave-stat-pending' : '') %>">
    <span class="leave-stat-value"><%= upcomingBills.length %></span>
    <span class="leave-stat-label">Bills due soon (<%= formatMoney(upcomingBillsTotal) %>)</span>
  </div>
</div>

<div class="dashboard-widgets">
<div class="dashboard-widget" data-widget="pending_approvals" style="order:<%= widgetOrder.indexOf('pending_approvals') %>;">
  <% if (isAdmin) { %><div class="dashboard-widget-handle" title="Drag to reorder">⠿ Drag to reorder</div><% } %>
<div class="card" style="border-left:6px solid #e2622b;">
  <h2>Pending Approvals</h2>
  <% var hasPending = pendingLeave.length || pendingTimesheets.length || lowStockItems.length; %>
  <% if (!hasPending) { %>
    <p class="text-muted">Nothing needs your attention right now.</p>
  <% } else { %>
    <% if (pendingLeave.length) { %>
      <div class="section-heading">Leave requests</div>
      <ul class="list list-scroll">
        <% pendingLeave.forEach(l => { %>
          <li>
            <a href="/leave" class="list-item">
              <span>
                <span class="list-item-title"><%= l.user_name %></span><br>
                <span class="list-item-meta"><%= formatAuDate(l.start_date) %> &ndash; <%= formatAuDate(l.end_date) %></span>
              </span>
              <span class="badge badge-in_progress">Pending</span>
            </a>
          </li>
        <% }) %>
      </ul>
    <% } %>
    <% if (pendingTimesheets.length) { %>
      <div class="section-heading">Timesheets</div>
      <ul class="list list-scroll">
        <% pendingTimesheets.forEach(t => { %>
          <li>
            <a href="/timeclock/timesheets?start=<%= t.week_start %>" class="list-item">
              <span>
                <span class="list-item-title"><%= t.user_name %></span><br>
                <span class="list-item-meta"><%= formatAuDate(t.week_start) %> &ndash; <%= formatAuDate(t.week_end) %></span>
              </span>
              <span><%= formatHours(t.total_minutes, true) %></span>
            </a>
          </li>
        <% }) %>
      </ul>
    <% } %>
    <% if (lowStockItems.length) { %>
      <div class="section-heading">Low stock</div>
      <ul class="list list-scroll">
        <% lowStockItems.forEach(item => { %>
          <li>
            <a href="/inventory/<%= item.id %>" class="list-item">
              <span class="list-item-title"><%= item.name %></span>
              <span class="badge badge-cancelled"><%= item.quantity_on_hand %> <%= item.unit %></span>
            </a>
          </li>
        <% }) %>
      </ul>
    <% } %>
  <% } %>
</div>
</div>

<div class="dashboard-widget" data-widget="upcoming_bills" style="order:<%= widgetOrder.indexOf('upcoming_bills') %>;">
  <% if (isAdmin) { %><div class="dashboard-widget-handle" title="Drag to reorder">⠿ Drag to reorder</div><% } %>
<div class="card" style="border-left:6px solid #dc3545;">
  <div style="display:flex;align-items:baseline;justify-content:space-between;gap:1rem;flex-wrap:wrap;">
    <h2 style="margin:0;">Upcoming Bills (<%= upcomingBills.length %>)</h2>
    <a href="/invoices?tab=bills" class="btn btn-secondary btn-sm">View all</a>
  </div>
  <% if (!upcomingBills.length) { %>
    <p class="text-muted" style="margin-top:0.75rem;">No unpaid bills due in the next 30 days.</p>
  <% } else { %>
    <ul class="list list-scroll" style="margin-top:0.75rem;">
      <% upcomingBills.forEach(b => {
           const overdue = b.due_date < todayIso;
      %>
        <li>
          <a href="/invoices?tab=bills" class="list-item">
            <span style="min-width:0;flex:1;">
              <span class="list-item-title"><%= b.supplier %></span><br>
              <span class="list-item-meta">
                <% if (b.supplier_invoice_number) { %><%= b.supplier_invoice_number %> &middot; <% } %>
                Due <%= formatAuDate(b.due_date) %>
                <% if (overdue) { %> &middot; <span style="color:var(--color-danger);font-weight:600;">Overdue</span><% } %>
              </span>
            </span>
            <span style="white-space:nowrap;font-weight:600;color:<%= overdue ? 'var(--color-danger)' : 'inherit' %>"><%= formatMoney(b.total) %></span>
          </a>
        </li>
      <% }) %>
    </ul>
  <% } %>
</div>
</div>

<div class="dashboard-widget" data-widget="job_pipeline" style="order:<%= widgetOrder.indexOf('job_pipeline') %>;">
  <% if (isAdmin) { %><div class="dashboard-widget-handle" title="Drag to reorder">⠿ Drag to reorder</div><% } %>
<div class="card" style="border-left:6px solid #12b8a0;">
  <h2>Job pipeline</h2>
  <div class="job-board">
    <div class="job-board-col">
      <div class="job-board-col-head job-board-col-unassigned">Unassigned (<%= jobBoard.unassigned.length %>)</div>
      <% if (!jobBoard.unassigned.length) { %>
        <p class="text-muted job-board-empty">Nothing here.</p>
      <% } else { %>
        <% jobBoard.unassigned.forEach(j => { %>
          <a href="/jobs/<%= j.id %>" class="job-card job-card-unassigned">
            <span class="job-card-title"><%= j.title %></span>
            <span class="job-card-meta"><%= j.customer_name %></span>
          </a>
        <% }) %>
      <% } %>
    </div>
    <div class="job-board-col">
      <div class="job-board-col-head job-board-col-scheduled">Scheduled (<%= jobBoard.scheduled.length %>)</div>
      <% if (!jobBoard.scheduled.length) { %>
        <p class="text-muted job-board-empty">Nothing here.</p>
      <% } else { %>
        <% jobBoard.scheduled.forEach(j => { %>
          <a href="/jobs/<%= j.id %>" class="job-card job-card-scheduled">
            <span class="job-card-title"><%= j.title %></span>
            <span class="job-card-meta"><%= j.customer_name %></span>
          </a>
        <% }) %>
      <% } %>
    </div>
    <div class="job-board-col">
      <div class="job-board-col-head job-board-col-completed">Completed (<%= jobBoard.completed.length %>)</div>
      <% if (!jobBoard.completed.length) { %>
        <p class="text-muted job-board-empty">Nothing here.</p>
      <% } else { %>
        <% jobBoard.completed.forEach(j => { %>
          <a href="/jobs/<%= j.id %>" class="job-card job-card-completed">
            <span class="job-card-title"><%= j.title %></span>
            <span class="job-card-meta"><%= j.customer_name %></span>
          </a>
        <% }) %>
      <% } %>
    </div>
    <div class="job-board-col">
      <div class="job-board-col-head job-board-col-invoiced">Invoiced (<%= jobBoard.invoiced.length %>)</div>
      <% if (!jobBoard.invoiced.length) { %>
        <p class="text-muted job-board-empty">Nothing here.</p>
      <% } else { %>
        <% jobBoard.invoiced.forEach(j => { %>
          <a href="/jobs/<%= j.id %>" class="job-card job-card-invoiced">
            <span class="job-card-title"><%= j.title %></span>
            <span class="job-card-meta"><%= j.customer_name %></span>
          </a>
        <% }) %>
      <% } %>
    </div>
  </div>
</div>
</div>

<div class="dashboard-widget" data-widget="quick_tasks" style="order:<%= widgetOrder.indexOf('quick_tasks') %>;">
  <% if (isAdmin) { %><div class="dashboard-widget-handle" title="Drag to reorder">⠿ Drag to reorder</div><% } %>
<div class="card" style="border-left:6px solid #7c5cff;">
  <h2>Quick Tasks (<%= activeTasks.length %>)</h2>
  <% if (!activeTasks.length) { %>
    <p class="text-muted">No open tasks.</p>
  <% } else { %>
    <ul class="list list-scroll">
      <% activeTasks.forEach(function(t) { %>
        <li>
          <a href="/tasks" class="list-item">
            <span>
              <span class="list-item-title"><%= t.title %></span><br>
              <span class="list-item-meta"><%= t.assignee_name || 'Anyone' %> &middot; added by <%= t.creator_name %></span>
            </span>
          </a>
        </li>
      <% }) %>
    </ul>
  <% } %>
</div>
</div>

<div class="dashboard-widget" data-widget="utilisation" style="order:<%= widgetOrder.indexOf('utilisation') %>;">
  <% if (isAdmin) { %><div class="dashboard-widget-handle" title="Drag to reorder">⠿ Drag to reorder</div><% } %>
<div class="card" style="border-left:6px solid #0891b2;">
  <h2>Technician utilisation (this week)</h2>
  <% if (!utilisation.length) { %>
    <p class="text-muted">No active technicians.</p>
  <% } else { %>
    <ul class="list">
      <% utilisation.forEach(u => { %>
        <li>
          <span class="list-item">
            <span class="list-item-title"><%= u.name %></span>
            <span><%= u.pct %>%</span>
          </span>
        </li>
      <% }) %>
    </ul>
  <% } %>
</div>
</div>

<div class="dashboard-widget" data-widget="upcoming_renewals" style="order:<%= widgetOrder.indexOf('upcoming_renewals') %>;">
  <% if (isAdmin) { %><div class="dashboard-widget-handle" title="Drag to reorder">⠿ Drag to reorder</div><% } %>
  <div class="card" style="border-left:6px solid #059669;">
    <div style="display:flex;align-items:center;justify-content:space-between;gap:1rem;margin-bottom:0.75rem;">
      <h2 style="margin:0;">Upcoming Renewals</h2>
      <a href="/renewals" class="btn btn-secondary btn-sm">View all</a>
    </div>
    <% if (!upcomingRenewalItems.length) { %>
      <p class="text-muted">No renewals due in the next 60 days.</p>
    <% } else { %>
      <ul class="list list-scroll">
        <% upcomingRenewalItems.forEach(function(item) {
          var today = new Date().toISOString().slice(0, 10);
          var isOverdue = item.expiry_date < today;
          var d30 = new Date(); d30.setDate(d30.getDate() + 30);
          var isDueSoon = !isOverdue && new Date(item.expiry_date) <= d30;
          var badgeCls = isOverdue ? 'badge-cancelled' : isDueSoon ? 'badge-overdue' : 'badge-in_progress';
          var badgeLabel = isOverdue ? 'Overdue' : isDueSoon ? 'Due soon' : 'Coming up';
          var href = item.asset_register_id ? '/assets/' + item.asset_register_id + '?returnTo=/dashboard' : '/renewals';
        %>
          <li>
            <a href="<%= href %>" class="list-item">
              <span>
                <span class="list-item-title"><%= item.title %></span><br>
                <span class="list-item-meta">
                  <%= item.category === 'vehicle_rego' ? 'Vehicle Rego' : item.category === 'licence' ? 'Staff Licence' : item.category === 'training' ? 'Training' : item.category === 'insurance' ? 'Insurance' : item.category === 'compliance' ? 'Compliance' : 'Other' %>
                  <% if (item.user_name) { %> &middot; <%= item.user_name %><% } %>
                  &middot; <%= formatAuDate(item.expiry_date) %>
                </span>
              </span>
              <span class="badge <%= badgeCls %>"><%= badgeLabel %></span>
            </a>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </div>
</div>

<div class="dashboard-widget" data-widget="business_milestones" style="order:<%= widgetOrder.indexOf('business_milestones') %>;">
  <% if (isAdmin) { %><div class="dashboard-widget-handle" title="Drag to reorder">⠿ Drag to reorder</div><% } %>
  <div class="card" style="border-left:6px solid #7c5cff;cursor:pointer;" onclick="window.location='/milestones'">
    <h2>Business Milestones</h2>
    <%
      var milestoneItems = [];
      upcomingBirthdays.forEach(function(u) {
        milestoneItems.push({ daysUntil: u.daysUntil, icon: '🎂', label: u.name, sub: 'Birthday &middot; ' + (u.daysUntil === 0 ? 'Today!' : u.daysUntil === 1 ? 'Tomorrow' : 'In ' + u.daysUntil + ' days') + ' &middot; ' + formatAuDate(u.nextBirthday) });
      });
      upcomingAnniversaries.forEach(function(u) {
        var yrs = u.yearsOfService;
        milestoneItems.push({ daysUntil: u.daysUntil, icon: '🏅', label: u.name, sub: yrs + ' year' + (yrs === 1 ? '' : 's') + ' with the team &middot; ' + (u.daysUntil === 0 ? 'Today!' : u.daysUntil === 1 ? 'Tomorrow' : 'In ' + u.daysUntil + ' days') + ' &middot; ' + formatAuDate(u.nextAnniv) });
      });
      upcomingCustomMilestones.forEach(function(m) {
        var dayStr = m.daysUntil === 0 ? 'Today!' : m.daysUntil === 1 ? 'Tomorrow' : 'In ' + m.daysUntil + ' days';
        milestoneItems.push({ daysUntil: m.daysUntil, icon: '⭐', label: m.displayTitle, sub: dayStr + ' &middot; ' + formatAuDate(m.nextDate) + (m.recurrence === 'annual' ? ' &middot; Annual' : '') });
      });
      milestoneItems.sort(function(a, b) { return a.daysUntil - b.daysUntil; });
    %>
    <% if (jobMilestone.justHit) { %>
      <div class="flash flash-success" style="margin-bottom:0.75rem;">🏆 Just hit job #<%= jobMilestone.totalJobs %>!</div>
    <% } else { %>
      <p class="text-muted" style="margin-bottom:0.75rem;font-size:0.85rem;">Job #<%= jobMilestone.nextJobMilestone %> milestone — <%= jobMilestone.jobsUntilMilestone %> job<%= jobMilestone.jobsUntilMilestone === 1 ? '' : 's' %> away (<%= jobMilestone.totalJobs %> total)</p>
    <% } %>
    <% if (!milestoneItems.length) { %>
      <p class="text-muted">No upcoming milestones in the next 30 days.</p>
    <% } else { %>
      <ul class="list">
        <% milestoneItems.forEach(function(m) { %>
          <li>
            <span class="list-item">
              <span>
                <span class="list-item-title"><%= m.label %></span><br>
                <span class="list-item-meta"><%- m.sub %></span>
              </span>
              <span style="font-size:1.5rem;"><%= m.icon %></span>
            </span>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </div>
</div>

<div class="dashboard-widget" data-widget="upcoming_maintenance" style="order:<%= widgetOrder.indexOf('upcoming_maintenance') %>;">
  <% if (isAdmin) { %><div class="dashboard-widget-handle" title="Drag to reorder">⠿ Drag to reorder</div><% } %>
<div class="card" style="border-left:6px solid #e2622b;">
  <h2>Vehicles &amp; equipment &mdash; upcoming maintenance</h2>
  <% if (!upcomingMaintenance.length) { %>
    <p class="text-muted">Nothing due for service, inspection or registration renewal in the next 30 days.</p>
  <% } else { %>
    <ul class="list">
      <% upcomingMaintenance.forEach(m => { %>
        <li>
          <span class="list-item">
            <span>
              <a href="/assets/<%= m.id %>?returnTo=/dashboard" class="list-item-title"><%= m.name %></a><br>
              <span class="list-item-meta">
                <%= m.category %> &middot; <%= m.reason %>
                <% if (m.dueDateIso) { %> <%= formatAuDate(m.dueDateIso) %><% } %>
                <% if (m.dueKm !== undefined) { %> <%= m.dueKm.toLocaleString() %> km (currently <%= m.currentKm.toLocaleString() %> km)<% } %>
              </span>
            </span>
            <span class="badge badge-<%= m.overdue ? 'cancelled' : 'scheduled' %>"><%= m.overdue ? 'overdue' : 'due soon' %></span>
          </span>
        </li>
      <% }) %>
    </ul>
  <% } %>
</div>
</div>

<div class="dashboard-widget" data-widget="bug_reports" style="order:<%= widgetOrder.indexOf('bug_reports') %>;">
  <% if (isAdmin) { %><div class="dashboard-widget-handle" title="Drag to reorder">⠿ Drag to reorder</div><% } %>
<div class="card" style="border-left:6px solid #d97706;">
  <h2>Bug Reports &amp; Ideas (<%= openFeedback.length %>)</h2>
  <% if (!openFeedback.length) { %>
    <p class="text-muted">No open items.</p>
  <% } else { %>
    <ul class="list list-scroll">
      <% openFeedback.forEach(function(f) { %>
        <li>
          <a href="/feedback" class="list-item">
            <span>
              <span class="list-item-title"><%= f.title %></span><br>
              <span class="list-item-meta">By <%= f.submitter_name %></span>
            </span>
            <span style="display:flex;flex-direction:column;align-items:flex-end;gap:0.3rem;">
              <span class="badge <%= f.type === 'bug' ? 'badge-cancelled' : 'badge-pending' %>"><%= f.type === 'bug' ? 'Bug' : 'Idea' %></span>
              <span class="badge <%= f.status === 'in_progress' ? 'badge-active' : '' %>"><%= f.status === 'in_progress' ? 'In progress' : 'Open' %></span>
            </span>
          </a>
        </li>
      <% }) %>
    </ul>
  <% } %>
</div>
</div>
</div>

<% if (isAdmin) { %>
<script>
(function () {
  var container = document.querySelector('.dashboard-widgets');
  if (!container) return;
  var csrf = '<%= csrfToken %>';
  var dragging = null;

  function widgetsByOrder() {
    return Array.prototype.slice.call(container.querySelectorAll('.dashboard-widget'))
      .sort(function (a, b) { return Number(a.style.order) - Number(b.style.order); });
  }

  function persist() {
    var order = widgetsByOrder().map(function (el) { return el.getAttribute('data-widget'); });
    fetch('/dashboard/layout', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ _csrf: csrf, order: order }),
    }).catch(function () {});
  }

  container.querySelectorAll('.dashboard-widget-handle').forEach(function (handle) {
    handle.setAttribute('draggable', 'true');

    handle.addEventListener('dragstart', function (e) {
      dragging = handle.closest('.dashboard-widget');
      dragging.classList.add('dashboard-widget-dragging');
      e.dataTransfer.effectAllowed = 'move';
      e.dataTransfer.setData('text/plain', dragging.getAttribute('data-widget'));
    });

    handle.addEventListener('dragend', function () {
      if (dragging) dragging.classList.remove('dashboard-widget-dragging');
      container.querySelectorAll('.dashboard-widget-dragover').forEach(function (el) {
        el.classList.remove('dashboard-widget-dragover');
      });
      dragging = null;
    });
  });

  container.querySelectorAll('.dashboard-widget').forEach(function (widget) {
    widget.addEventListener('dragover', function (e) {
      if (!dragging || dragging === widget) return;
      e.preventDefault();
      e.dataTransfer.dropEffect = 'move';
      widget.classList.add('dashboard-widget-dragover');
    });

    widget.addEventListener('dragleave', function () {
      widget.classList.remove('dashboard-widget-dragover');
    });

    widget.addEventListener('drop', function (e) {
      if (!dragging || dragging === widget) return;
      e.preventDefault();
      widget.classList.remove('dashboard-widget-dragover');

      var all = widgetsByOrder().filter(function (el) { return el !== dragging; });
      var targetIdx = all.indexOf(widget);
      var rect = widget.getBoundingClientRect();
      var before = (e.clientY - rect.top) < rect.height / 2;
      all.splice(before ? targetIdx : targetIdx + 1, 0, dragging);

      all.forEach(function (el, i) { el.style.order = i; });
      persist();
    });
  });
})();
</script>
<% } %>
<%- include('../partials/footer') %>
