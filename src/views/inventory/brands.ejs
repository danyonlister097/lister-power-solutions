<%- include('../partials/header', { title: 'Inventory Brands' }) %>
<div class="page-header">
  <h1>Inventory Brands</h1>
  <a class="btn btn-secondary btn-sm" href="/inventory">Back to Inventory</a>
</div>

<p class="text-muted" style="margin-top:-0.5rem;">
  A supplier code is almost always a brand's own prefix plus a product-line code, e.g. <strong>HAG</strong>ADC932T for Hager. Label a prefix once and every item sharing it - past and future imports alike - gets that brand, so techs can search by brand name instead of needing the exact code.
</p>

<div class="section-heading">Needs a brand (<%= unresolved.length %> prefix<%= unresolved.length === 1 ? '' : 'es' %>)</div>
<% if (!unresolved.length) { %>
  <p class="text-muted">Every coded item has a brand.</p>
<% } else { %>
  <ul class="list">
    <% unresolved.forEach(function (g) { %>
      <li>
        <form method="post" action="/inventory/brands" class="form-row form-row-3" style="align-items:flex-end;">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="prefix" value="<%= g.prefix %>">
          <label style="margin:0;">
            <strong><%= g.prefix %></strong> &middot; <%= g.count %> item<%= g.count === 1 ? '' : 's' %>
            <span class="text-muted" style="display:block;font-size:0.8rem;font-weight:400;margin-top:0.2rem;">e.g. &ldquo;<%= g.example %>&rdquo; (<%= g.exampleCode %>)</span>
          </label>
          <label style="margin:0;">
            Brand
            <input type="text" name="brand" placeholder="e.g. Clipsal" required>
          </label>
          <div class="actions" style="margin:0;">
            <button type="submit" class="btn btn-primary btn-sm">Apply to <%= g.count %></button>
          </div>
        </form>
      </li>
    <% }) %>
  </ul>
<% } %>

<div class="section-heading">Known prefixes (<%= known.length %>)</div>
<% if (!known.length) { %>
  <p class="text-muted">None labelled yet.</p>
<% } else { %>
  <div class="timesheet-scroll">
    <table class="timesheet-table">
      <thead>
        <tr>
          <th>Prefix</th>
          <th>Brand</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% known.forEach(function (k) { %>
          <tr>
            <td><%= k.prefix %></td>
            <td><%= k.brand %></td>
            <td>
              <form method="post" action="/inventory/brands" style="display:flex;gap:0.5rem;margin:0;align-items:center;">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="prefix" value="<%= k.prefix %>">
                <input type="text" name="brand" value="<%= k.brand %>" style="width:auto;margin:0;">
                <button type="submit" class="btn btn-secondary btn-sm">Update</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>
<%- include('../partials/footer') %>
